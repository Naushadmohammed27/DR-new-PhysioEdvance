<!-- ============ UNIFIED ROYAL GRADIENT HERO BANNER ============ -->
<section class="pe-subject-hero position-relative py-5 text-white overflow-hidden" style="background: linear-gradient(135deg, #0b192c 0%, #1e3e62 55%, #000000 100%); border-bottom: 1px solid rgba(255,255,255,0.1);">
  <!-- Ambient background glow effect -->
  <div class="position-absolute top-0 end-0 rounded-circle opacity-20 pointer-events-none" style="width: 400px; height: 400px; background: radial-gradient(circle, #38bdf8 0%, transparent 70%); transform: translate(30%, -30%);"></div>

  <div class="container position-relative z-2 py-3">
    <nav class="pe-breadcrumb mb-3" style="font-size: 0.88rem;">
      <a href="/subjects" class="text-white-50 text-decoration-none hover-white"><i class="ri-home-3-line me-1"></i> Subjects</a>
      <i class="ri-arrow-right-s-line mx-1.5 text-white-50"></i>
      <a href="/subjects/<%= category.slug %>" class="text-white-50 text-decoration-none hover-white"><%= category.name %></a>
      <i class="ri-arrow-right-s-line mx-1.5 text-white-50"></i>
      <span class="badge bg-warning-subtle text-warning font-weight-bold text-uppercase px-2.5 py-1 rounded-pill" style="font-size: 0.75rem;"><%= activeSection.replace('-', ' ') %></span>
    </nav>

    <div class="d-flex align-items-center justify-content-between flex-wrap gap-4">
      <div class="d-flex align-items-center gap-3.5">
        <div class="pe-subject-hero-icon shadow-lg" style="width: 72px; height: 72px; background: linear-gradient(135deg, rgba(255,255,255,0.2) 0%, rgba(255,255,255,0.05) 100%); border: 1.5 solid rgba(255,255,255,0.3); border-radius: 20px; display: flex; align-items: center; justify-content: center; font-size: 2.25rem; color: #ffffff; backdrop-filter: blur(12px);">
          <i class="<%= category.icon || 'ri-book-open-line' %>"></i>
        </div>
        <div>
          <div class="d-flex align-items-center gap-2 mb-1.5 flex-wrap">
            <span class="badge bg-primary-subtle text-light border border-primary-subtle font-weight-bold text-uppercase px-3 py-1 rounded-pill" style="font-size: 0.72rem; letter-spacing: 0.5px;">
              <i class="ri-sparkles-fill text-warning me-1"></i> DEDICATED DIGITAL MODULE
            </span>
            <span class="badge bg-white bg-opacity-10 text-white font-weight-medium px-2.5 py-1 rounded-pill small">
              <i class="ri-award-line me-1 text-warning"></i> BPT & MPT Academic Library
            </span>
          </div>
          <h1 class="text-white fw-bold display-6 mb-0 text-capitalize tracking-tight"><%= category.name %>: <%= activeSection.replace('-', ' ') %></h1>
        </div>
      </div>

      <a href="/subjects/<%= category.slug %>" class="btn btn-outline-light rounded-pill px-4 py-2 font-weight-bold shadow-sm d-inline-flex align-items-center gap-2 transition-all hover-lift" style="border-width: 1.5px; backdrop-filter: blur(8px);">
        <i class="ri-arrow-left-line fs-5"></i> Back to <%= category.name %> Hub
      </a>
    </div>
  </div>
</section>

<!-- ============ NAVIGATION SWITCHER TABS ============ -->
<section class="border-bottom sticky-top shadow-sm z-3" style="top:64px; background: rgba(255, 255, 255, 0.96); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px);">
  <div class="container overflow-auto py-2.5 no-scrollbar">
    <div class="d-flex gap-2 flex-nowrap align-items-center">
      <a href="/subjects/<%= category.slug %>/module/syllabus" class="btn btn-sm rounded-pill font-weight-bold px-3.5 py-2 transition-all <%= activeSection==='syllabus' ? 'btn-primary shadow-sm active-tab-glow' : 'btn-light border text-secondary hover-primary' %>">
        <i class="ri-quill-pen-line me-1.5"></i> Syllabus
      </a>
      <a href="/subjects/<%= category.slug %>/module/regions" class="btn btn-sm rounded-pill font-weight-bold px-3.5 py-2 transition-all <%= activeSection==='regions' ? 'btn-primary shadow-sm active-tab-glow' : 'btn-light border text-secondary hover-primary' %>">
        <i class="ri-brain-line me-1.5"></i> Regions & Maps
      </a>
      <a href="/subjects/<%= category.slug %>/module/hd-videos" class="btn btn-sm rounded-pill font-weight-bold px-3.5 py-2 transition-all <%= activeSection==='hd-videos' ? 'btn-primary shadow-sm active-tab-glow' : 'btn-light border text-secondary hover-primary' %>">
        <i class="ri-vidicon-line me-1.5"></i> HD Videos
      </a>
      <a href="/subjects/<%= category.slug %>/module/interactive-modules" class="btn btn-sm rounded-pill font-weight-bold px-3.5 py-2 transition-all <%= activeSection==='interactive-modules' ? 'btn-primary shadow-sm active-tab-glow' : 'btn-light border text-secondary hover-primary' %>">
        <i class="ri-focus-3-line me-1.5"></i> Interactive Hotspots
      </a>

      <a href="/subjects/<%= category.slug %>/module/cross-sections" class="btn btn-sm rounded-pill font-weight-bold px-3.5 py-2 transition-all <%= activeSection==='cross-sections' ? 'btn-primary shadow-sm active-tab-glow' : 'btn-light border text-secondary hover-primary' %>">
        <i class="ri-layout-grid-line me-1.5"></i> Cross-Sections
      </a>
      <a href="/subjects/<%= category.slug %>/module/mri-scans" class="btn btn-sm rounded-pill font-weight-bold px-3.5 py-2 transition-all <%= activeSection==='mri-scans' ? 'btn-primary shadow-sm active-tab-glow' : 'btn-light border text-secondary hover-primary' %>">
        <i class="ri-pulse-line me-1.5"></i> MRIs & Radiology
      </a>
      <a href="/subjects/<%= category.slug %>/module/stroke-models" class="btn btn-sm rounded-pill font-weight-bold px-3.5 py-2 transition-all <%= activeSection==='stroke-models' ? 'btn-primary shadow-sm active-tab-glow' : 'btn-light border text-secondary hover-primary' %>">
        <i class="ri-heart-pulse-line me-1.5"></i> Pathology Models
      </a>
      <a href="/subjects/<%= category.slug %>/module/notes" class="btn btn-sm rounded-pill font-weight-bold px-3.5 py-2 transition-all <%= activeSection==='notes' ? 'btn-primary shadow-sm active-tab-glow' : 'btn-light border text-secondary hover-primary' %>">
        <i class="ri-file-text-line me-1.5"></i> Curriculum Notes
      </a>
      <a href="/subjects/<%= category.slug %>/module/research" class="btn btn-sm rounded-pill font-weight-bold px-3.5 py-2 transition-all <%= activeSection==='research' ? 'btn-primary shadow-sm active-tab-glow' : 'btn-light border text-secondary hover-primary' %>">
        <i class="ri-microscope-line me-1.5"></i> Research Desk
      </a>
    </div>
  </div>
</section>

<!-- ============ DEDICATED MODULE CONTENT DISPLAY ============ -->
<%
  const sectionFeatureMap = {
    'syllabus': '8',
    'regions': '3',
    'hd-videos': '5',
    'interactive-modules': '6',
    'cross-sections': '4',
    'mri-scans': '7',
    'stroke-models': '9',
    'notes': '8',
    'research': '8',
    'intro': '1'
  };
  const currentFeatureId = sectionFeatureMap[activeSection] || '1';
  const isSectionActive = (locals.activeFeatures && Array.isArray(activeFeatures)) ? activeFeatures.includes(String(currentFeatureId)) : true;
%>
<div class="pe-section bg-light-subtle py-5">
  <div class="container">

    <% if (!isSectionActive) { %>
      <!-- ============ COMING SOON DISPLAY FOR INACTIVE SECTIONS ============ -->
      <div class="card border-0 shadow-lg rounded-4 p-5 text-center bg-white my-4 mx-auto" style="max-width: 680px;">
        <div class="mb-3">
          <div class="d-inline-flex p-3 rounded-circle bg-warning-subtle text-warning mb-2 shadow-xs" style="font-size: 2.5rem; width: 76px; height: 76px; align-items: center; justify-content: center;">
            <i class="ri-time-line"></i>
          </div>
        </div>
        <div class="mb-2">
          <span class="badge bg-warning text-dark font-weight-bold px-3 py-1 rounded-pill">UNDER ACTIVE DEVELOPMENT</span>
        </div>
        <h3 class="fw-bold text-dark mb-2 text-capitalize"><%= activeSection.replace('-', ' ') %> for <%= category.name %> is Coming Soon</h3>
        <p class="text-muted mb-4 lead" style="font-size: 1.05rem; line-height: 1.6;">
          This interactive clinical module is currently under active development for <strong><%= category.name %></strong> by our medical faculty. It will be released in an upcoming update.
        </p>
        <div class="d-flex align-items-center justify-content-center gap-2.5 flex-wrap">
          <a href="/subjects/<%= category.slug %>" class="btn btn-primary rounded-pill px-4 py-2.5 font-weight-bold shadow-sm" style="background: #0a5dc2; border: none;">
            <i class="ri-arrow-left-line me-1"></i> Back to <%= category.name %> Hub
          </a>
          <a href="/subjects/<%= category.slug %>/course" class="btn btn-outline-secondary rounded-pill px-4 py-2.5 font-weight-bold">
            <i class="ri-play-circle-line me-1"></i> Browse Active Courses
          </a>
        </div>
      </div>
    <% } else { %>

    <!-- 1. SYLLABUS & TOPICS -->
    <% if (activeSection === 'syllabus') { %>
      <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
        <div>
          <h3 class="fw-bold text-dark mb-1"><i class="ri-book-open-line text-primary me-2"></i>Complete <%= category.name %> Syllabus & Topics</h3>
          <p class="text-muted small mb-0">Full curriculum units, lecture objectives, and high-yield examination topics for BPT & MPT students.</p>
        </div>
        <span class="badge bg-primary text-white rounded-pill px-3.5 py-2 font-weight-bold">
          <%= (interactiveData.syllabusUnits || []).length %> Academic Units
        </span>
      </div>

      <div class="row g-4">
        <% (interactiveData.syllabusUnits || []).forEach((u, uIdx) => { %>
          <div class="col-md-6">
            <div class="card h-100 border-0 shadow-sm rounded-4 p-4 bg-white">
              <div class="d-flex align-items-center justify-content-between mb-3">
                <span class="badge bg-primary text-white font-weight-bold px-3 py-1 rounded-pill small"><%= u.unit %></span>
                <span class="badge bg-success-subtle text-success font-weight-bold px-2.5 py-1 rounded-pill small"><i class="ri-checkbox-circle-fill me-1"></i> Core Module</span>
              </div>
              <h4 class="fw-bold text-dark mb-2"><%= u.title %></h4>
              <p class="text-secondary small mb-3 leading-relaxed" style="font-size: 0.92rem; line-height: 1.6;"><%= u.description %></p>
              
              <div class="fw-bold small text-dark mb-2"><i class="ri-key-line text-warning me-1"></i> Key Learning Objectives:</div>
              <ul class="list-unstyled mb-3">
                <% u.objectives.forEach(obj => { %>
                  <li class="small text-secondary mb-2 d-flex align-items-start"><i class="ri-arrow-right-circle-fill text-primary me-2 mt-0.5"></i> <%= obj %></li>
                <% }) %>
              </ul>

              <div class="border-top pt-3 mt-auto">
                <div class="fw-bold small text-dark mb-2">High-Yield Exam Topics:</div>
                <div class="d-flex flex-wrap gap-1.5">
                  <% u.topics.forEach(tp => { %>
                    <span class="badge bg-light text-dark border rounded-pill px-3 py-1.5 small fw-semibold"><%= tp %></span>
                  <% }) %>
                </div>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>

    <!-- 4. STUDY NOTES & FULL PAGE DOCUMENT READER -->
    <% if (activeSection === 'interactive-modules' || activeSection === 'notes') { %>
      <style>
        .note-card-fullscreen {
          position: fixed !important;
          top: 0 !important;
          left: 0 !important;
          width: 100vw !important;
          height: 100vh !important;
          z-index: 999999 !important;
          border-radius: 0 !important;
          margin: 0 !important;
          background: #0f172a !important;
          overflow-y: auto !important;
        }
        .note-card-fullscreen iframe {
          height: calc(100vh - 65px) !important;
          min-height: calc(100vh - 65px) !important;
        }
        .active-tab-glow {
          background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%) !important;
          border: none !important;
          box-shadow: 0 4px 14px rgba(2, 132, 199, 0.4) !important;
        }
        .no-scrollbar::-webkit-scrollbar {
          display: none;
        }
        .no-scrollbar {
          -ms-overflow-style: none;
          scrollbar-width: none;
        }
        .hover-lift {
          transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .hover-lift:hover {
          transform: translateY(-2px);
          box-shadow: 0 6px 20px rgba(0, 0, 0, 0.08) !important;
        }
        .hotspot-pin-btn {
          cursor: pointer;
          font-family: system-ui, -apple-system, sans-serif;
          transition: all 0.28s cubic-bezier(0.34, 1.56, 0.64, 1);
        }
        .hotspot-pin-btn:hover {
          transform: translate(-50%, -50%) scale(1.18) !important;
          box-shadow: 0 0 0 6px rgba(2, 132, 199, 0.3) !important;
        }
        .active-pin {
          animation: pinPulseGlow 2s infinite ease-in-out;
        }
        @keyframes pinPulseGlow {
          0%, 100% {
            box-shadow: 0 0 0 5px rgba(10, 93, 194, 0.45), 0 8px 18px rgba(10, 93, 194, 0.35);
          }
          50% {
            box-shadow: 0 0 0 9px rgba(10, 93, 194, 0.2), 0 10px 22px rgba(10, 93, 194, 0.45);
          }
        }
        .med-section-card {
          border-radius: 12px;
          transition: all 0.22s ease-in-out;
          border: 1px solid rgba(226, 232, 240, 0.85);
          background: #ffffff;
        }
        .med-section-card:hover {
          border-color: #cbd5e1;
          box-shadow: 0 4px 14px rgba(15, 23, 42, 0.05);
          transform: translateY(-1px);
        }
        .pin-selector-tab {
          transition: all 0.2s ease;
        }
        .pin-selector-tab:hover {
          transform: translateY(-1px);
        }
      </style>

      <!-- SECTION HEADER BANNER -->
      <div class="card border-0 shadow-sm rounded-4 p-4 bg-white border mb-4">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
          <div>
            <div class="d-flex align-items-center gap-2 mb-2">
              <span class="badge rounded-pill font-weight-bold px-3 py-1.5 shadow-sm text-white" style="background: linear-gradient(135deg, #0284c7 0%, #0a5dc2 100%); font-size: 0.78rem; letter-spacing: 0.5px;">
                <i class="ri-sparkles-line me-1.5"></i> NOTES & INTERACTIVE MODULES STUDIO
              </span>
              <span class="badge bg-success-subtle text-success font-weight-bold px-2.5 py-1 rounded-pill small">
                <i class="ri-shield-check-line me-1"></i> Verified Subject Library
              </span>
            </div>
            <h3 class="fw-bold text-dark mb-1 d-flex align-items-center gap-2">
              <i class="ri-file-text-fill text-primary"></i> <%= category.name %> Notes & Interactive Modules Studio
            </h3>
            <p class="text-secondary small mb-0 leading-relaxed" style="font-size: 0.94rem;">
              Inspect interactive 3D rotatable WebGL models, high-resolution text images & diagrams, PDF reading notes, and video prosections directly inside the studio.
            </p>
          </div>
        </div>
      </div>

      <% if (notes && notes.length > 0) { %>
        <%
          function getNoteItemType(item) {
            const ext = ((item.file_url || '').split('?')[0].split('.').pop() || '').toLowerCase();
            const isImgFile = ['png', 'jpg', 'jpeg', 'webp', 'svg', 'gif', 'dicom'].includes(ext);
            const isPdfFile = ext === 'pdf';
            const is3dFile = ['glb', 'gltf', 'zip', 'html', 'htm'].includes(ext);

            if (isImgFile || (item.content || '').includes('[INTERACTIVE_MODULE:TEXT_IMAGE]')) {
              return 'text_image';
            }
            if (is3dFile || (item.content || '').includes('[INTERACTIVE_MODULE:3D]')) {
              return '3d_model';
            }
            if (isPdfFile) {
              return 'pdf';
            }
            if ((item.title || '').toLowerCase().includes('image') || (item.title || '').toLowerCase().includes('diagram')) {
              return 'text_image';
            }
            return 'pdf';
          }

          function getCleanNoteTitle(n, categoryName) {
            let raw = (n.title || '').trim();
            const text = ((n.title || '') + ' ' + (n.content || '') + ' ' + (n.file_url || '')).toLowerCase();
            
            const isUglyFilename = /whatsapp|img_\d|pxl_\d|screenshot|scan_\d|file_\d|untitled|\.png|\.jpeg|\.jpg|\.gif/i.test(raw);
            
            if (isUglyFilename || !raw) {
              if (text.includes('clavicle') || text.includes('shoulder') || text.includes('acromion')) {
                return 'Clavicle & Shoulder Girdle Anatomy';
              } else if (text.includes('head') || text.includes('skull') || text.includes('brain') || text.includes('cranium')) {
                return 'Cranial Vault & Head Neuroanatomy';
              } else if (text.includes('knee') || text.includes('patell') || text.includes('femur') || text.includes('tibia')) {
                return 'Knee Joint & Extensor Mechanism';
              } else if (text.includes('spine') || text.includes('cervical') || text.includes('lumbar') || text.includes('thoracic') || text.includes('sacrum')) {
                return 'Vertebral Column & Spinal Segment';
              } else if (text.includes('heart') || text.includes('cardiac') || text.includes('pulmonary') || text.includes('lung')) {
                return 'Cardiac System & Thoracic Viscera';
              } else if (text.includes('hand') || text.includes('wrist') || text.includes('carpal') || text.includes('phalang') || text.includes('metacarpal') || text.includes('finger') || text.includes('thumb')) {
                return 'Hand & Upper Extremity Complex';
              } else if (text.includes('foot') || text.includes('ankle') || text.includes('tarsal') || text.includes('calcaneus') || text.includes('metatarsal') || text.includes('plantar') || text.includes('hallux')) {
                return 'Foot & Ankle Biomechanical Unit';
              } else if (text.includes('hip') || text.includes('pelvis') || text.includes('acetabulum') || text.includes('gluteal') || text.includes('ilium') || text.includes('trochanter')) {
                return 'Hip Joint & Pelvic Girdle Anatomy';
              } else if (text.includes('elbow') || text.includes('epicondyle') || text.includes('olecranon') || text.includes('forearm') || text.includes('cubital')) {
                return 'Elbow Joint & Forearm Anatomy';
              } else {
                return (categoryName || 'Anatomy') + ' Interactive Module & Diagram';
              }
            }
            return raw;
          }

          let pdfCount = 0;
          let textImageCount = 0;
          notes.forEach(n => {
            const t = getNoteItemType(n);
            if (t === 'text_image') textImageCount++;
            else if (t === 'pdf') pdfCount++;
          });
        %>
        <!-- NOTE & INTERACTIVE MODULE TITLE SELECTION PILLS WITH TYPE FILTERS -->
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white border mb-4">
          <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
            <div class="d-flex align-items-center gap-2.5">
              <div class="p-2 rounded-3 bg-primary-subtle text-primary">
                <i class="ri-folder-shared-fill fs-5"></i>
              </div>
              <div>
                <h6 class="fw-bold text-dark mb-0">Select Interactive Module / Note Title (<span id="availableNotesCount"><%= notes.length %></span> Available)</h6>
                <span class="text-muted small">Click any item title below to open in studio</span>
              </div>
            </div>
            <span class="badge bg-light text-secondary border font-weight-medium rounded-pill px-3 py-1.5">
              <i class="ri-cursor-line me-1 text-primary"></i> Interactive Selector
            </span>
          </div>

          <!-- TYPE FILTER CATEGORY TABS -->
          <div class="d-flex align-items-center gap-2 mb-3 flex-wrap border-bottom pb-3">
            <button type="button" class="btn btn-sm rounded-pill font-weight-bold px-3.5 py-2 btn-primary shadow-xs filter-type-btn transition-all hover-lift" data-filter="all" onclick="filterNotesByType('all', this)">
              <i class="ri-apps-2-line me-1"></i> All Items (<%= notes.length %>)
            </button>
            <button type="button" class="btn btn-sm rounded-pill font-weight-bold px-3.5 py-2 btn-light border text-dark filter-type-btn transition-all hover-lift" data-filter="pdf" onclick="filterNotesByType('pdf', this)">
              <i class="ri-file-pdf-fill text-danger me-1"></i> PDF Reading Notes (<%= pdfCount %>)
            </button>
            <button type="button" class="btn btn-sm rounded-pill font-weight-bold px-3.5 py-2 btn-light border text-dark filter-type-btn transition-all hover-lift" data-filter="text_image" onclick="filterNotesByType('text_image', this)">
              <i class="ri-image-2-fill text-success me-1"></i> Text Images & Diagrams (<%= textImageCount %>)
            </button>
          </div>

          <div class="d-flex gap-2.5 flex-wrap" id="noteTitlePills">
            <div id="noNotesFilterAlert" class="d-none text-muted small py-3 px-3 bg-light rounded-3 w-100 text-center border">
              <i class="ri-information-line me-1 text-primary"></i> No notes or modules found for this filter category.
            </div>
            <% notes.forEach((n, idx) => { %>
              <% 
                const itemType = getNoteItemType(n);
                const isImage = itemType === 'text_image';
                const is3d = itemType === '3d_model';
                const isPdf = itemType === 'pdf';
                const cleanDisplayTitle = getCleanNoteTitle(n, typeof category !== 'undefined' ? category.name : '');
              %>
              <button type="button" 
                      data-type="<%= itemType %>" 
                      data-note-idx="<%= idx %>" 
                      class="btn btn-sm rounded-pill font-weight-bold px-4 py-2.5 transition-all note-pill-btn <%= idx === 0 ? 'btn-primary shadow-sm active-note-btn' : 'btn-light border text-dark hover-lift' %>" 
                      style="<%= idx === 0 ? 'background: linear-gradient(135deg, #0a5dc2 0%, #0284c7 100%); border: none;' : '' %>" 
                      onclick="switchActiveNote(<%= idx %>, this)">
                <% if (isImage) { %>
                  <i class="ri-image-fill text-success me-1.5 fs-6"></i> <%= cleanDisplayTitle %> <span class="badge bg-success-subtle text-success ms-1 small">Text Image</span>
                <% } else if (is3d) { %>
                  <i class="ri-sparkles-fill text-info me-1.5 fs-6"></i> <%= cleanDisplayTitle %> <span class="badge bg-info-subtle text-info ms-1 small">Interactive Module</span>
                <% } else { %>
                  <i class="<%= isPdf ? 'ri-file-pdf-2-fill text-danger' : 'ri-file-word-fill text-primary' %> me-1.5 fs-6"></i> <%= cleanDisplayTitle %>
                <% } %>
              </button>
            <% }) %>
          </div>
        </div>

        <%
          function getNoteHotspots(n) {
            const text = ((n.title || '') + ' ' + (n.content || '') + ' ' + (n.file_url || '')).toLowerCase();
            
            // 1. HEAD, SKULL, BRAIN & CRANIAL NEUROLOGICAL SYSTEM
            if (text.includes('head') || text.includes('skull') || text.includes('brain') || text.includes('cerebr') || text.includes('cranium') || text.includes('cranial') || text.includes('cephalic') || text.includes('prefrontal') || text.includes('temporal lobe') || text.includes('occipital') || text.includes('parietal') || text.includes('cerebell') || text.includes('brainstem')) {
              return [
                {
                  id: 1,
                  title: 'Cranial Vault & Prefrontal Cortex (Executive Control)',
                  subtitle: 'Calvarium & Superior Frontal Neocortex (Brodmann 9, 10, 11, 46)',
                  whatItMeans: 'The cranial vault forms the protective bony dome of the skull, enclosing the prefrontal cortex situated in the anterior frontal lobes.',
                  whatItDoes: 'Coordinates higher-order executive function, working memory, impulse suppression, spatial attention, and strategic motor planning.',
                  whyWeNeedIt: 'Protects fragile cerebral tissue from direct mechanical impact while enabling goal-directed behavior, social cognition, and emotional regulation.',
