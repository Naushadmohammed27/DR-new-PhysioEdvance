            const importanceSnippet = sentences.length > 4 ? sentences.slice(4, 6).join(' ') : `Protects underlying neurovascular structures, maintains anatomical integrity, and supports normal kinetic chain function.`;

            return [
              {
                id: 1,
                title: cleanTitle + ' - Superior Landmark & Overview',
                subtitle: cleanTitle + ' (Anatomical Region 1)',
                whatItMeans: summarySnippet,
                whatItDoes: actionSnippet,
                whyWeNeedIt: importanceSnippet,
                nerveSupply: 'Regional Somatic Innervation & Arterial Vascular Supply',
                relatedTopics: cleanTitle + ' Assessment, Biomechanical Kinematics & Clinical Pathologies',
                action: 'Primary Load Transmission & Structural Support',
                clinicalPearl: 'Palpation and targeted clinical motion testing isolate structural dysfunction and alignment in ' + cleanTitle + '.'
              },
              {
                id: 2,
                title: cleanTitle + ' - Structural Architecture & Biomechanics',
                subtitle: cleanTitle + ' (Anatomical Region 2)',
                whatItMeans: `Detailed anatomical composition and connective tissue arrangement of ${cleanTitle}.`,
                whatItDoes: `Facilitates specialized physiological motion, structural alignment, and force absorption across ${cleanTitle}.`,
                whyWeNeedIt: `Ensures stability under mechanical loads and prevents pathological shear forces within ${cleanTitle}.`,
                nerveSupply: 'Subcortical Sensory Endings & Periosteal / Articular Vascular Networks',
                relatedTopics: cleanTitle + ' Stress-Strain Dynamics & Structural Stability',
                action: 'Biomechanical Force Absorption & Joint Alignment',
                clinicalPearl: 'Assess active and passive range of motion to determine capsular versus non-capsular restriction patterns.'
              },
              {
                id: 3,
                title: cleanTitle + ' - Physiological Function & Clinical Purpose',
                subtitle: cleanTitle + ' (Anatomical Region 3)',
                whatItMeans: `Functional unit contributing to systemic biological homeostasis and motor coordination in ${cleanTitle}.`,
                whatItDoes: `Provides dynamic motor leverage and passive structural restraint during functional activity.`,
                whyWeNeedIt: `Essential for preserving normal kinetic chain function and preventing compensatory overload in adjacent segments.`,
                nerveSupply: 'Segmental Motor Branches & Deep Venous Drainage',
                relatedTopics: cleanTitle + ' Functional Rehabilitation & Kinetic Chain Biomechanics',
                action: 'Dynamic Motor Leverage & Passive Restraint',
                clinicalPearl: 'Resisted isometric strength testing isolates muscular weakness from non-contractile tissue pathology.'
              },
              {
                id: 4,
                title: cleanTitle + ' - Neurovascular & Arterial Supply Pathway',
                subtitle: cleanTitle + ' (Anatomical Region 4)',
                whatItMeans: `Neurovascular bundle routing sensory, motor, and autonomic fibers through ${cleanTitle}.`,
                whatItDoes: `Delivers oxygenated blood and nutrient supply while providing proprioceptive biofeedback to the central nervous system.`,
                whyWeNeedIt: `Critical for tissue viability, rapid cellular repair, and reflex motor control.`,
                nerveSupply: 'Major Regional Nerve Plexus & Branching Arterial Network',
                relatedTopics: cleanTitle + ' Ischemic Syndromes, Nerve Compression & Entrapment Neuropathies',
                action: 'Proprioceptive Biofeedback & Vascular Perfusion',
                clinicalPearl: 'Screen for dermatomal sensory alterations, myotomal weakness, and peripheral pulse symmetry.'
              },
              {
                id: 5,
                title: cleanTitle + ' - High-Yield Clinical Pearl & Diagnostic Assessment',
                subtitle: cleanTitle + ' (Anatomical Region 5)',
                whatItMeans: `Core clinical examination findings, provocative testing, and diagnostic evaluation for ${cleanTitle}.`,
                whatItDoes: `Guides evidence-based physical diagnosis, manual therapy interventions, and therapeutic exercise prescription.`,
                whyWeNeedIt: `Prevents misdiagnosis, optimizes patient outcomes, and prevents chronic functional disability.`,
                nerveSupply: 'Reflex Arc Fibers & Autonomic Vasomotor Regulation',
                relatedTopics: cleanTitle + ' Provocative Physical Examination Tests & Rehabilitation Protocols',
                action: 'Diagnostic Clinical Evaluation & Functional Recovery',
                clinicalPearl: 'Combine clinical special tests with high-resolution imaging for definitive diagnosis of structural lesions in ' + cleanTitle + '.'
              }
            ];
          }
        %>

        <!-- FULL PAGE DOCUMENT & INTERACTIVE MODULE VIEWER CARDS -->
        <% notes.forEach((note, idx) => { %>
          <% 
            const ext = ((note.file_url || '').split('?')[0].split('.').pop() || '').toLowerCase();
            const itemType = getNoteItemType(note);
            const isImage = itemType === 'text_image';
            const is3d = itemType === '3d_model';
            const isPdf = itemType === 'pdf';
            const noteHotspots = getNoteHotspots(note);
            const firstHotspot = noteHotspots[0];
          %>
          <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white border mb-4 note-viewer-card <%= idx === 0 ? '' : 'd-none' %>" id="note-card-<%= idx %>">
            
            <!-- HEADER BAR WITH TITLE & EXPAND TOGGLE -->
            <div class="card-header p-3.5 d-flex align-items-center justify-content-between flex-wrap gap-2 text-white" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%); border-bottom: 1px solid rgba(255,255,255,0.1);">
              <div class="d-flex align-items-center gap-2.5">
                <% if (isImage) { %>
                  <div class="bg-success text-white rounded-3 px-2 py-1 shadow-sm d-flex align-items-center justify-content-center">
                    <i class="ri-image-line fs-5"></i>
                  </div>
                <% } else if (is3d) { %>
                  <div class="bg-info text-dark rounded-3 px-2 py-1 shadow-sm d-flex align-items-center justify-content-center">
                    <i class="ri-sparkles-line fs-5"></i>
                  </div>
                <% } else { %>
                  <div class="bg-danger text-white rounded-3 px-2 py-1 shadow-sm d-flex align-items-center justify-content-center">
                    <i class="ri-file-pdf-2-fill fs-5"></i>
                  </div>
                <% } %>
                <div>
                  <h6 class="fw-bold text-white mb-0" style="letter-spacing: -0.2px;"><%= getCleanNoteTitle(note, typeof category !== 'undefined' ? category.name : '') %></h6>
                  <span class="text-white-50 small" style="font-size: 0.78rem;">
                    <i class="ri-shield-check-line text-success me-1"></i> Verified Subject Module
                  </span>
                </div>
              </div>

              <div class="d-flex align-items-center gap-2">
                <% if (isImage) { %>
                  <span class="badge bg-success bg-opacity-20 text-success border border-success border-opacity-20 rounded-pill px-3 py-1.5 font-weight-medium">
                    <i class="ri-zoom-in-line me-1"></i> Zoomable Text Image
                  </span>
                  <a href="<%= note.file_url %>" target="_blank" class="btn btn-sm btn-outline-light rounded-pill px-3.5 py-1.5 font-weight-semibold">
                    <i class="ri-external-link-line me-1"></i> Open Full HD Image
                  </a>
                <% } else if (is3d) { %>
                  <span class="badge bg-info bg-opacity-20 text-info border border-info border-opacity-20 rounded-pill px-3 py-1.5 font-weight-medium">
                    <i class="ri-sparkles-line me-1"></i> Interactive WebGL Module
                  </span>
                  <button type="button" class="btn btn-sm btn-info rounded-pill px-4 py-1.5 font-weight-bold text-dark shadow-sm fullscreen-toggle-btn" onclick="toggleInPageFullscreen('note-card-<%= idx %>')">
                    <i class="ri-expand-arrows-line me-1"></i> Expand Studio
                  </button>
                <% } else { %>
                  <span class="badge bg-white bg-opacity-10 text-light font-weight-medium rounded-pill px-3 py-1.5 d-none d-sm-inline-flex align-items-center">
                    <i class="ri-aspect-ratio-line me-1 text-info"></i> Fit Width Reader
                  </span>
                  <button type="button" class="btn btn-sm rounded-pill px-4 py-1.5 font-weight-bold text-white shadow-sm fullscreen-toggle-btn transition-all hover-lift" style="background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%); border: none;" onclick="toggleInPageFullscreen('note-card-<%= idx %>')">
                    <i class="ri-expand-arrows-line me-1"></i> Expand Full Page
                  </button>
                <% } %>
              </div>
            </div>

            <!-- VIEWER BODY -->
            <div class="card-body p-0 bg-white">
              <% if (note.content) { %>
                <!-- SUMMARY & OBJECTIVES HIGHLIGHTS BOX (ELEGANT CLINICAL CALLOUT) -->
                <div class="p-3.5 p-md-4 border-bottom position-relative" style="background: linear-gradient(135deg, #f8fafc 0%, #f0f9ff 100%); border-left: 5px solid #0284c7;">
                  <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-2">
                    <span class="badge rounded-pill text-uppercase font-weight-bold px-3 py-1 shadow-xs" style="background: #e0f2fe; color: #0369a1; font-size: 0.76rem; letter-spacing: 0.5px;">
                      <i class="ri-book-read-line me-1"></i> Academic Syllabus & Overview
                    </span>
                    <span class="text-muted small" style="font-size: 0.8rem;">
                      <i class="ri-check-double-line text-success me-1"></i> High-Yield Physiotherapy Competency
                    </span>
                  </div>
                  <h6 class="fw-bold text-dark mb-1.5 d-flex align-items-center gap-2" style="letter-spacing: -0.2px;">
                    <i class="ri-award-line text-primary fs-5"></i> Module Objectives & Core Takeaways
                  </h6>
                  <div class="text-secondary small leading-relaxed" style="font-size: 0.94rem; line-height: 1.7; color: #334155;">
                    <%- note.content.replace(/\[INTERACTIVE_MODULE.*?\]/g, '').replace(/\n/g, '<br>') %>
                  </div>
                </div>
              <% } %>

              <% if (is3d) { %>
                <!-- 3D WEBGL ROTATABLE MODEL STUDIO VIEWER -->
                <div class="p-4 text-center position-relative overflow-hidden" style="background: linear-gradient(135deg, #0b192c 0%, #1e3e62 100%);">
                  <div class="d-flex align-items-center justify-content-between mb-3 text-white flex-wrap gap-2">
                    <span class="badge bg-info text-dark rounded-pill px-3 py-1.5 font-weight-bold d-inline-flex align-items-center gap-1.5">
                      <i class="ri-sparkles-line fs-6"></i> Interactive WebGL Module Studio
                    </span>
                    <span class="text-white-50 small">
                      <i class="ri-drag-move-line text-warning me-1"></i> Drag / Touch to Rotate 360°
                    </span>
                  </div>

                  <div class="p-3 bg-dark rounded-4 border border-secondary shadow-lg position-relative d-flex align-items-center justify-content-center" style="min-height: 480px; background: #0b192c !important;">
                    <% if (note.file_url && (note.file_url.endsWith('.html') || note.file_url.endsWith('.htm') || note.file_url.endsWith('.zip'))) { %>
                      <iframe src="<%= note.file_url %>" title="<%= note.title %>" style="width: 100%; height: 65vh; border: none;" allowfullscreen onload="checkIframeNotLogin(this)"></iframe>
                    <% } else { %>
                      <!-- ROYAL 3D CANVAS SIMULATOR WITH REAL-TIME ROTATABLE MODEL INTERFACING -->
                      <div class="w-100 py-2 text-center text-white position-relative">
                        <canvas id="canvas3D-<%= idx %>" class="note-3d-canvas" style="width: 100%; max-width: 720px; height: 420px; cursor: grab; background: transparent; display: block; margin: 0 auto;"></canvas>
                        <div class="mt-2 text-center">
                          <span class="badge bg-dark bg-opacity-75 text-warning border border-secondary rounded-pill px-3.5 py-1.5 small font-weight-bold">
                            <i class="ri-drag-move-line me-1"></i> Drag Mouse or Touch Screen to Orbit & Rotate 360° Real-Time 3D Engine
                          </span>
                        </div>
                      </div>
                    <% } %>
                  </div>
                </div>

              <% } else if (isImage) { %>
                <!-- INTERACTIVE HD HOTSPOT IDENTIFICATION MODEL (DUAL-COLUMN STUDIO) -->
                <div class="p-3 p-md-4 bg-white">
                  
                  <!-- SECTION TITLE BANNER -->
                  <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-4 pb-3 border-bottom">
                    <div class="d-flex align-items-center gap-3">
                      <div class="rounded-3 shadow-xs d-flex align-items-center justify-content-center text-white" style="width: 46px; height: 46px; background: linear-gradient(135deg, #0284c7 0%, #0a5dc2 100%);">
                        <i class="ri-focus-3-line fs-4"></i>
                      </div>
                      <div>
                        <div class="d-flex align-items-center gap-2 mb-0.5">
                          <h5 class="fw-bold text-dark mb-0" style="letter-spacing: -0.2px;">Interactive Anatomical Hotspot Studio</h5>
                          <span class="badge rounded-pill px-2.5 py-0.5 font-weight-semibold" style="background: #e0f2fe; color: #0369a1; font-size: 0.72rem;">5 PIN LANDMARKS</span>
                        </div>
                        <p class="text-muted small mb-0" style="font-size: 0.88rem;">
                          Select any pin (P1–P5) on the diagram or use the quick tabs to explore clinical anatomy, biomechanics, and assessment pearls.
                        </p>
                      </div>
                    </div>
                    <% if (note.file_url && note.file_url !== '/images/logo-icon.png') { %>
                      <a href="<%= note.file_url %>" target="_blank" class="btn btn-sm btn-outline-primary rounded-pill px-3.5 py-2 font-weight-semibold d-inline-flex align-items-center gap-1.5 transition-all hover-lift" style="border-width: 1.5px;">
                        <i class="ri-external-link-line fs-6"></i> Open Full HD Image
                      </a>
                    <% } %>
                  </div>

                  <div class="row g-4 align-items-stretch">
                    
                    <!-- LEFT COLUMN: DIAGRAM WITH NUMBERED HOTSPOT PIN BUTTONS 1-5 -->
                    <div class="col-lg-5 col-md-6">
                      <div class="p-3.5 rounded-4 border h-100 position-relative d-flex flex-column align-items-center justify-content-between overflow-hidden shadow-xs" style="background: #f8fafc;">
                        <div class="d-flex align-items-center justify-content-between w-100 mb-2 px-1 text-muted small" style="font-size: 0.8rem;">
                          <span><i class="ri-hand-coin-line text-primary me-1"></i> Click pins to inspect</span>
                          <span class="badge bg-white text-secondary border rounded-pill px-2.5 py-1">High-Res Diagram</span>
                        </div>

                        <% const displayImg = (note.file_url && note.file_url !== '/images/logo-icon.png') ? note.file_url : 'https://images.unsplash.com/photo-1579684385127-1ef15d508118?w=800&auto=format&fit=crop&q=80'; %>
                        <div class="position-relative w-100 text-center my-auto p-2 bg-white rounded-3 shadow-xs border" style="max-height: 520px; display: flex; align-items: center; justify-content: center;">
                          <img src="<%= displayImg %>" alt="<%= getCleanNoteTitle(note, typeof category !== 'undefined' ? category.name : '') %>" class="img-fluid rounded-3 w-100" style="max-height: 480px; object-fit: contain; cursor: zoom-in;" onclick="window.open(this.src, '_blank')">

                          <!-- 5 NUMBERED INTERACTIVE PIN BUTTONS OVERLAID ON IMAGE -->
                          <% 
                            const defaultPins = [
                              { id: 1, top: '22%', left: '50%' },
                              { id: 2, top: '48%', left: '50%' },
                              { id: 3, top: '64%', left: '48%' },
                              { id: 4, top: '78%', left: '50%' },
                              { id: 5, top: '88%', left: '52%' }
                            ];
                          %>
                          <% defaultPins.forEach(pin => { %>
                            <button type="button" 
                                    id="pin-btn-<%= idx %>-<%= pin.id %>" 
                                    class="btn rounded-circle p-0 font-weight-bold shadow hotspot-pin-btn <%= pin.id === 1 ? 'active-pin' : '' %>" 
                                    style="position: absolute; top: <%= pin.top %>; left: <%= pin.left %>; transform: translate(-50%, -50%); width: 36px; height: 36px; line-height: 36px; background: <%= pin.id === 1 ? 'linear-gradient(135deg, #0a5dc2 0%, #0284c7 100%)' : 'linear-gradient(135deg, #f59e0b 0%, #d97706 100%)' %>; color: #ffffff; border: 2.5px solid #ffffff; font-size: 0.95rem; z-index: 10;" 
                                    onclick="selectHotspotPin('<%= idx %>', <%= pin.id %>, this)">
                              <%= pin.id %>
                            </button>
                          <% }) %>
                        </div>

                        <div class="w-100 mt-2 text-center">
                          <span class="text-muted" style="font-size: 0.78rem;">
                            <i class="ri-zoom-in-line text-primary me-1"></i> Click on the image to view in original full resolution
                          </span>
                        </div>
                      </div>
                    </div>

                    <!-- RIGHT COLUMN: DYNAMIC & CLICKABLE PIN STRUCTURE DETAIL CARD -->
                    <div class="col-lg-7 col-md-6">
                      <div class="p-3.5 p-md-4 bg-white rounded-4 border h-100 d-flex flex-column justify-content-between shadow-xs" id="pinDetailCard-<%= idx %>" style="border-color: #e2e8f0;">
                        
                        <div>
                          <!-- TOP INTERACTIVE PIN SELECTOR STRIP -->
                          <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2 pb-3 border-bottom">
                            <div class="d-flex align-items-center gap-1.5 flex-wrap">
                              <span class="text-secondary small font-weight-bold me-1" style="font-size: 0.84rem;">
                                <i class="ri-map-pin-user-line text-primary me-1"></i> Landmark:
                              </span>
                              <% (noteHotspots || []).forEach(pin => { %>
                                <button type="button" 
                                        id="pin-tab-<%= idx %>-<%= pin.id %>" 
                                        class="btn btn-sm rounded-pill font-weight-bold px-3 py-1.5 pin-selector-tab <%= pin.id === 1 ? 'btn-primary shadow-sm active' : 'btn-light border text-dark hover-lift' %>" 
                                        style="font-size: 0.82rem; <%= pin.id === 1 ? 'background: linear-gradient(135deg, #0a5dc2 0%, #0284c7 100%); border: none;' : '' %>"
                                        onclick="selectHotspotPin('<%= idx %>', <%= pin.id %>)"
                                        title="Click to view details for <%= pin.title %>">
                                  <i class="ri-map-pin-2-fill me-1 <%= pin.id === 1 ? 'text-white' : 'text-primary' %>"></i> P<%= pin.id %>
                                </button>
                              <% }) %>
                            </div>
                            <div class="d-flex align-items-center gap-1.5">
                              <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3 py-1.5 font-weight-semibold hover-lift" onclick="cycleHotspotPin('<%= idx %>', -1)" title="Previous Landmark">
                                <i class="ri-arrow-left-s-line"></i> Prev
                              </button>
                              <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3 py-1.5 font-weight-semibold hover-lift" onclick="cycleHotspotPin('<%= idx %>', 1)" title="Next Landmark">
                                Next <i class="ri-arrow-right-s-line"></i>
                              </button>
                            </div>
                          </div>

                          <!-- FULL WIDTH PIN STRUCTURE BADGE (CLICKABLE) -->
                          <div class="badge w-100 py-2.5 rounded-3 font-weight-bold text-white mb-3 shadow-xs d-flex align-items-center justify-content-between px-3.5" 
                               id="pinBadge-<%= idx %>" 
                               style="background: linear-gradient(135deg, #0a5dc2 0%, #0284c7 100%) !important; font-size: 0.88rem; letter-spacing: 0.3px; cursor: pointer;"
                               onclick="cycleHotspotPin('<%= idx %>', 1)"
                               title="Click to advance to the next anatomical landmark">
                            <span><i class="ri-focus-2-line me-1.5"></i> Pin Structure #1 (Active Landmark)</span>
                            <span class="small font-weight-normal opacity-75 d-none d-sm-inline">Next Landmark <i class="ri-arrow-right-line ms-1"></i></span>
                          </div>

                          <!-- MAIN STRUCTURE HEADING & SUBTITLE -->
                          <div class="p-3.5 rounded-3 border mb-3 transition-all hover-lift" 
                               onclick="cycleHotspotPin('<%= idx %>', 1)" 
                               style="background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%); cursor: pointer; border-color: #cbd5e1;" 
                               title="Click to advance to the next anatomical structure">
                            <div class="d-flex align-items-center justify-content-between mb-1 flex-wrap gap-2">
                              <h4 class="fw-bold text-dark mb-0" id="pinTitle-<%= idx %>" style="letter-spacing: -0.3px; font-size: 1.35rem;">
                                <%= firstHotspot.title %>
                              </h4>
                              <span class="badge rounded-pill px-3 py-1.5 font-weight-semibold shadow-xs" id="pinSubtitle-<%= idx %>" style="background: #e0f2fe; color: #0284c7; font-size: 0.78rem;">
                                <%= firstHotspot.subtitle || 'Anatomical Segment' %>
                              </span>
                            </div>
                          </div>

                          <!-- 1. WHAT IT MEANS (ANATOMY & DEFINITION) -->
                          <div class="p-3.5 med-section-card mb-3 transition-all hover-lift" 
                               style="border-left: 4px solid #0284c7 !important; cursor: pointer;"
                               onclick="pulseDetailCard(this)"
                               title="Anatomical Definition & Overview">
                            <div class="fw-bold small mb-1.5 d-flex align-items-center justify-content-between" style="color: #0369a1;">
                              <span class="d-flex align-items-center gap-1.5">
                                <i class="ri-book-open-line fs-5"></i> 1. What It Means (Anatomy & Definition):
                              </span>
                              <span class="badge rounded-pill px-2.5 py-0.5 small" style="background: #e0f2fe; color: #0284c7;">Anatomy</span>
                            </div>
                            <p class="text-dark small mb-0 leading-relaxed" id="pinMeaning-<%= idx %>" style="font-size: 0.92rem; line-height: 1.7; color: #1e293b;">
                              <%= firstHotspot.whatItMeans || firstHotspot.description %>
                            </p>
                          </div>

                          <!-- 2. WHAT IT DOES (FUNCTION & BIOMECHANICS) -->
                          <div class="p-3.5 med-section-card mb-3 transition-all hover-lift" 
                               style="border-left: 4px solid #0d9488 !important; cursor: pointer;"
                               onclick="pulseDetailCard(this)"
                               title="Functional Actions & Biomechanics">
                            <div class="fw-bold small mb-1.5 d-flex align-items-center justify-content-between" style="color: #0f766e;">
                              <span class="d-flex align-items-center gap-1.5">
                                <i class="ri-settings-3-line fs-5"></i> 2. What It Does (Function & Biomechanics):
                              </span>
                              <span class="badge text-white small rounded-pill px-2.5 py-0.5" style="background: #0d9488;">Function</span>
                            </div>
                            <p class="text-dark small mb-0 leading-relaxed" id="pinDoes-<%= idx %>" style="font-size: 0.92rem; line-height: 1.7; color: #1e293b;">
                              <%= firstHotspot.whatItDoes || firstHotspot.action %>
                            </p>
                          </div>

                          <!-- 3. WHY WE NEED IT (PURPOSE & CLINICAL IMPORTANCE) -->
                          <div class="p-3.5 med-section-card mb-3 transition-all hover-lift" 
                               style="border-left: 4px solid #d97706 !important; cursor: pointer;"
                               onclick="pulseDetailCard(this)"
                               title="Why the Human Body Needs This Structure">
                            <div class="fw-bold small mb-1.5 d-flex align-items-center justify-content-between" style="color: #b45309;">
                              <span class="d-flex align-items-center gap-1.5">
                                <i class="ri-heart-pulse-line fs-5"></i> 3. Why We Need It (Purpose & Importance):
                              </span>
                              <span class="badge rounded-pill px-2.5 py-0.5 small" style="background: #fef3c7; color: #92400e;">Clinical Purpose</span>
                            </div>
                            <p class="text-dark small mb-0 leading-relaxed" id="pinWhy-<%= idx %>" style="font-size: 0.92rem; line-height: 1.7; color: #1e293b;">
                              <%= firstHotspot.whyWeNeedIt || 'Maintains structural equilibrium, force distribution, and protects vital neurovascular tissues.' %>
                            </p>
                          </div>

                          <!-- 4. INNERVATION & ARTERIAL SUPPLY -->
                          <div class="p-3.5 med-section-card mb-3 transition-all hover-lift" 
                               style="border-left: 4px solid #6366f1 !important; cursor: pointer;"
                               onclick="pulseDetailCard(this)"
                               title="Innervation and Vascular Pathway">
                            <div class="fw-bold small mb-1 d-flex align-items-center justify-content-between" style="color: #4338ca;">
                              <span class="d-flex align-items-center gap-1.5">
                                <i class="ri-flashlight-fill fs-5" style="color: #6366f1;"></i> Innervation & Arterial Supply:
                              </span>
                              <span class="badge rounded-pill px-2.5 py-0.5 small" style="background: #e0e7ff; color: #4338ca;">Neural & Vascular</span>
                            </div>
                            <div class="font-weight-semibold small" id="pinNerve-<%= idx %>" style="font-size: 0.92rem; color: #1e1b4b;">
                              <%= firstHotspot.nerveSupply %>
                            </div>
                          </div>

                          <!-- 5. RELATED TOPICS & CLINICAL CONDITIONS -->
                          <div class="p-3.5 med-section-card mb-3 transition-all hover-lift" 
                               style="border-left: 4px solid #a855f7 !important; cursor: pointer;"
                               onclick="pulseDetailCard(this)"
                               title="Related Clinical Pathologies & Conditions">
                            <div class="fw-bold small mb-1 d-flex align-items-center justify-content-between" style="color: #7e22ce;">
                              <span class="d-flex align-items-center gap-1.5">
                                <i class="ri-links-line fs-5" style="color: #a855f7;"></i> Related Topics & Clinical Conditions:
                              </span>
                              <span class="badge rounded-pill px-2.5 py-0.5 small" style="background: #f3e8ff; color: #7e22ce;">Pathologies</span>
                            </div>
                            <div class="small leading-relaxed" id="pinRelated-<%= idx %>" style="font-size: 0.90rem; color: #3b0764;">
                              <%= firstHotspot.relatedTopics || 'Spinal kinematics, postural dysfunction, and nerve root decompression therapy.' %>
                            </div>
                          </div>

                          <!-- 6. HIGH-YIELD CLINICAL EXAM PEARL & ASSESSMENT -->
                          <div class="p-3.5 med-section-card transition-all hover-lift" 
                               style="border-left: 4px solid #16a34a !important; cursor: pointer;"
                               onclick="pulseDetailCard(this)"
                               title="High-Yield Clinical Examination Pearl">
                            <div class="fw-bold small mb-1 d-flex align-items-center justify-content-between" style="color: #15803d;">
                              <span class="d-flex align-items-center gap-1.5">
                                <i class="ri-lightbulb-flash-fill fs-5" style="color: #16a34a;"></i> High-Yield Clinical Exam Pearl & Assessment:
                              </span>
                              <span class="badge text-white small rounded-pill px-2.5 py-0.5" style="background: #16a34a;">Exam Pearl</span>
                            </div>
                            <div class="small leading-relaxed" id="pinPearl-<%= idx %>" style="font-size: 0.89rem; color: #14532d;">
                              <%= firstHotspot.clinicalPearl || 'Palpation and clinical motion testing isolate structural dysfunction and neural impingement.' %>
                            </div>
                          </div>
                        </div>

                      </div>
                    </div>

                  </div>
                </div>

              <% } else if (note.file_url) { %>
                <% 
                  const isAuthOrLoginUrl = (note.file_url || '').includes('/auth/') || (note.file_url || '').includes('/login') || (note.file_url || '').startsWith('/student/') || (note.file_url || '').startsWith('/admin/');
                %>
                <% if (isAuthOrLoginUrl) { %>
                  <div class="p-5 text-center bg-white rounded-4 border my-3">
                    <div class="py-4">
                      <div class="bg-warning-subtle text-warning rounded-circle d-inline-flex align-items-center justify-content-center mb-3 shadow-sm" style="width: 76px; height: 76px;">
                        <i class="ri-file-lock-line display-5"></i>
                      </div>
                      <h4 class="fw-bold text-dark mb-2">Attachment Access Restricted</h4>
                      <p class="text-secondary small mb-3 mx-auto leading-relaxed" style="max-width: 520px;">
                        This study note attachment is restricted to registered users or requires account authorization. Please log in to your student account to access this material.
                      </p>
                      <a href="/auth/login" class="btn btn-primary rounded-pill px-4 py-2 font-weight-bold shadow-sm" style="background: #0a5dc2; border: none;">
                        <i class="ri-user-shared-line me-1"></i> Log In to Access Note
                      </a>
                    </div>
                  </div>
                <% } else if (ext === 'pdf') { %>
                  <iframe src="<%= note.file_url %>#view=FitH&toolbar=0&navpanes=0&scrollbar=1" title="<%= note.title %>" style="width: 100%; height: 85vh; border: none; background: #ffffff;" allowfullscreen onload="checkIframeNotLogin(this)"></iframe>
                <% } else { %>
                  <!-- DOCX / DOC / TXT / PPT IN-PAGE DOCUMENT VIEWER & DOWNLOAD TOOLBAR -->
                  <div class="p-4 p-md-5 bg-white font-sans text-dark">
                    <div class="d-flex align-items-center justify-content-between p-3 rounded-4 bg-light border mb-4 flex-wrap gap-2 shadow-sm">
                      <div class="d-flex align-items-center gap-2.5">
                        <div class="rounded-3 bg-primary text-white p-2.5 d-flex align-items-center justify-content-center" style="width: 42px; height: 42px;">
                          <i class="ri-file-word-fill fs-4"></i>
                        </div>
                        <div>
                          <h6 class="fw-bold text-dark mb-0"><%= getCleanNoteTitle(note, typeof category !== 'undefined' ? category.name : '') %></h6>
                          <span class="text-muted small"><%= ext.toUpperCase() %> Document • In-Page Reader & Study Takeaways</span>
                        </div>
                      </div>
                      <a href="<%= note.file_url %>" download class="btn btn-sm btn-primary rounded-pill px-4 py-2 font-weight-bold shadow-sm d-inline-flex align-items-center gap-2" style="background: linear-gradient(135deg, #0a5dc2 0%, #0284c7 100%); border: none;">
                        <i class="ri-download-cloud-2-line fs-6"></i> Download Original <%= ext.toUpperCase() %> Document
                      </a>
                    </div>
                  </div>
                <% } %>
              <% } else if (!note.content) { %>
                <div class="p-5 text-center text-muted">
                  <i class="ri-file-text-line display-4 mb-2 opacity-50"></i>
                  <p class="mb-0 font-weight-bold">No document file attached for this entry.</p>
                </div>
              <% } %>
            </div>
          </div>
        <% }) %>

        <script>
          let currentNotesFilterType = 'all';

          function checkIframeNotLogin(iframe) {
            if (!iframe) return;
            try {
              const iframeDoc = iframe.contentDocument || (iframe.contentWindow && iframe.contentWindow.document);
              if (iframeDoc) {
                const text = (iframeDoc.body ? iframeDoc.body.innerHTML : '') + (iframeDoc.title || '');
                if (text.includes('Login to PhysioEdvance') || text.includes('Two-step verification required') || iframeDoc.querySelector('form[action*="/auth/login"]')) {
                  console.warn('Iframe redirected to login page. Hiding iframe.');
                  iframe.style.display = 'none';
                  const parent = iframe.parentElement;
                  if (parent && !parent.querySelector('.iframe-login-fallback')) {
                    const fallback = document.createElement('div');
                    fallback.className = 'iframe-login-fallback p-5 text-center bg-white rounded-4 border my-3';
                    fallback.innerHTML = `
                      <div class="py-4">
                        <div class="bg-warning-subtle text-warning rounded-circle d-inline-flex align-items-center justify-content-center mb-3 shadow-sm" style="width: 76px; height: 76px;">
                          <i class="ri-file-lock-line display-5"></i>
                        </div>
                        <h4 class="fw-bold text-dark mb-2">Document Access Restricted</h4>
                        <p class="text-secondary small mb-3 mx-auto leading-relaxed" style="max-width: 520px;">
                          This study note attachment is restricted or requires login authentication to view. Please log in to your student account to open this file.
                        </p>
                        <a href="/auth/login" class="btn btn-primary rounded-pill px-4 py-2 font-weight-bold shadow-sm" style="background: #0a5dc2; border: none;">
                          <i class="ri-user-shared-line me-1"></i> Log In to Access Document
                        </a>
                      </div>
                    `;
                    parent.appendChild(fallback);
                  }
                }
              }
            } catch (e) {
              // Cross-origin iframe or browser security restriction
            }
          }

          function switchActiveNote(targetIdx, btnEl) {
            // Show target card and hide others
            document.querySelectorAll('.note-viewer-card').forEach((card, i) => {
              if (i === targetIdx) {
                card.classList.remove('d-none');
              } else {
                card.classList.add('d-none');
              }
            });

            // Update pill styling WITHOUT wiping d-none or display style!
            document.querySelectorAll('#noteTitlePills .note-pill-btn').forEach(btn => {
              btn.classList.remove('btn-primary', 'shadow-sm', 'active-note-btn');
              btn.classList.add('btn-light', 'border', 'text-dark', 'hover-lift');
              btn.style.background = '';
              btn.style.border = '';
            });

            if (btnEl) {
              btnEl.classList.remove('btn-light', 'border', 'text-dark', 'hover-lift');
              btnEl.classList.add('btn-primary', 'shadow-sm', 'active-note-btn');
              btnEl.style.background = 'linear-gradient(135deg, #0a5dc2 0%, #0284c7 100%)';
              btnEl.style.border = 'none';
            }

            // Ensure non-matching pills strictly stay hidden if a filter is active
            if (currentNotesFilterType !== 'all') {
              document.querySelectorAll('.note-pill-btn').forEach(pill => {
                const pillType = pill.getAttribute('data-type');
                if (pillType !== currentNotesFilterType) {
                  pill.style.setProperty('display', 'none', 'important');
                  pill.classList.add('d-none');
                }
              });
            }

            init3DCanvasForIndex(targetIdx);
          }

          function filterNotesByType(type, btnEl) {
            currentNotesFilterType = type;

            // 1. Update filter tab buttons UI
            document.querySelectorAll('.filter-type-btn').forEach(btn => {
              btn.classList.remove('btn-primary', 'shadow-sm');
              btn.classList.add('btn-light', 'border', 'text-dark');
            });
            if (btnEl) {
              btnEl.classList.remove('btn-light', 'border', 'text-dark');
              btnEl.classList.add('btn-primary', 'shadow-sm');
            }

            // 2. Filter the note pills
            const pills = document.querySelectorAll('.note-pill-btn');
            let firstMatch = null;
            let visibleCount = 0;

            pills.forEach(pill => {
              const pillType = pill.getAttribute('data-type');
              const idx = parseInt(pill.getAttribute('data-note-idx'), 10);
              const match = (type === 'all' || pillType === type);

              if (match) {
                pill.style.setProperty('display', 'inline-flex', 'important');
                pill.classList.remove('d-none');
                visibleCount++;
                if (!firstMatch) {
                  firstMatch = { idx, el: pill };
                }
              } else {
                pill.style.setProperty('display', 'none', 'important');
                pill.classList.add('d-none');
              }
            });

            // 3. Update count header if present
            const countHeaderEl = document.getElementById('availableNotesCount');
            if (countHeaderEl) {
              countHeaderEl.textContent = visibleCount;
            }

            // 4. Handle empty state if no matches
            const noAlert = document.getElementById('noNotesFilterAlert');
            if (noAlert) {
              if (visibleCount === 0) {
                noAlert.classList.remove('d-none');
                document.querySelectorAll('.note-viewer-card').forEach(card => card.classList.add('d-none'));
              } else {
                noAlert.classList.add('d-none');
              }
            }

            // 5. Switch active note to the first matching visible item
            if (firstMatch) {
              switchActiveNote(firstMatch.idx, firstMatch.el);
            }
          }

          const allNotesHotspotsMap = {};
          <% notes.forEach((note, idx) => { %>
            allNotesHotspotsMap['<%= idx %>'] = <%- JSON.stringify(getNoteHotspots(note)) %>;
          <% }) %>

          const activePinIdMap = {};

          function selectHotspotPin(noteIdx, pinId, btnEl) {
            activePinIdMap[noteIdx] = pinId;
            const list = allNotesHotspotsMap[noteIdx] || [];
            const item = list.find(h => h.id === pinId) || list[(pinId - 1) % (list.length || 1)] || {
              title: 'Pin Structure #' + pinId,
              description: 'Anatomical landmark detail for pin structure #' + pinId + '.',
              nerveSupply: 'Regional Nerve Supply',
              action: 'Anatomical Function & Clinical Significance',
              clinicalPearl: 'Palpation and clinical motion testing isolate structural dysfunction and neural impingement.'
            };

            // 1. Update image pin buttons on the diagram
            const diagramPinBtn = document.getElementById('pin-btn-' + noteIdx + '-' + pinId);
            document.querySelectorAll('[id^="pin-btn-' + noteIdx + '-"]').forEach(btn => {
              btn.style.background = 'linear-gradient(135deg, #f59e0b 0%, #d97706 100%)';
              btn.style.color = '#ffffff';
              btn.style.transform = 'translate(-50%, -50%) scale(1)';
              btn.style.boxShadow = '';
              btn.classList.remove('active-pin');
            });
            if (diagramPinBtn) {
              diagramPinBtn.style.background = 'linear-gradient(135deg, #0a5dc2 0%, #0284c7 100%)';
              diagramPinBtn.style.color = '#ffffff';
              diagramPinBtn.style.transform = 'translate(-50%, -50%) scale(1.22)';
              diagramPinBtn.classList.add('active-pin');
            }

            // 2. Update the pin-tab buttons in the detail card strip
            document.querySelectorAll('[id^="pin-tab-' + noteIdx + '-"]').forEach(tab => {
              tab.classList.remove('btn-primary', 'shadow-sm', 'active');
              tab.classList.add('btn-light', 'border', 'text-dark', 'hover-lift');
              tab.style.background = '';
              tab.style.border = '';
              const icon = tab.querySelector('i');
              if (icon) {
                icon.classList.remove('text-white');
                icon.classList.add('text-primary');
              }
            });

            const activeTab = document.getElementById('pin-tab-' + noteIdx + '-' + pinId);
            if (activeTab) {
              activeTab.classList.remove('btn-light', 'border', 'text-dark', 'hover-lift');
              activeTab.classList.add('btn-primary', 'shadow-sm', 'active');
              activeTab.style.background = 'linear-gradient(135deg, #0a5dc2 0%, #0284c7 100%)';
              activeTab.style.border = 'none';
              const icon = activeTab.querySelector('i');
              if (icon) {
                icon.classList.remove('text-primary');
                icon.classList.add('text-white');
              }
            }

            // 3. Update text content in detail card
            const badge = document.getElementById('pinBadge-' + noteIdx);
            const title = document.getElementById('pinTitle-' + noteIdx);
            const subtitle = document.getElementById('pinSubtitle-' + noteIdx);
            const meaning = document.getElementById('pinMeaning-' + noteIdx);
            const does = document.getElementById('pinDoes-' + noteIdx);
            const why = document.getElementById('pinWhy-' + noteIdx);
            const nerve = document.getElementById('pinNerve-' + noteIdx);
            const related = document.getElementById('pinRelated-' + noteIdx);
            const pearl = document.getElementById('pinPearl-' + noteIdx);

            if (badge) {
              badge.innerHTML = '<span><i class="ri-focus-2-line me-1.5"></i> Pin Structure #' + pinId + ' (Active Landmark)</span><span class="small font-weight-normal opacity-75 d-none d-sm-inline">Next Landmark <i class="ri-arrow-right-line ms-1"></i></span>';
            }
            if (title) title.innerText = item.title;
            if (subtitle) subtitle.innerText = item.subtitle || 'Anatomical Landmark';
            if (meaning) meaning.innerText = item.whatItMeans || item.description || 'Anatomical landmark definition and structural arrangement.';
            if (does) does.innerText = item.whatItDoes || item.action || 'Biomechanical kinematics and functional actions.';
            if (why) why.innerText = item.whyWeNeedIt || 'Critical structural protection, force transmission, and physiological support.';
            if (nerve) nerve.innerText = item.nerveSupply || 'Regional Somatic Nerves & Arterial Supply';
            if (related) related.innerText = item.relatedTopics || 'Spinal kinematics, postural stability, and clinical pathologies.';
            if (pearl) pearl.innerText = item.clinicalPearl || 'Palpation and clinical motion testing isolate structural dysfunction and neural impingement.';

            // 4. Subtle pulse animation on detail card
            const detailCard = document.getElementById('pinDetailCard-' + noteIdx);
            if (detailCard) {
              detailCard.style.transition = 'box-shadow 0.25s ease';
              detailCard.style.boxShadow = '0 0 0 3px rgba(10, 93, 194, 0.25)';
              setTimeout(() => {
                detailCard.style.boxShadow = '';
              }, 400);
            }
          }

          function cycleHotspotPin(noteIdx, delta) {
            const list = allNotesHotspotsMap[noteIdx] || [1, 2, 3, 4, 5];
            const count = list.length || 5;
            const currentPin = activePinIdMap[noteIdx] || 1;
            let nextPin = currentPin + delta;
            if (nextPin > count) nextPin = 1;
            if (nextPin < 1) nextPin = count;
            selectHotspotPin(noteIdx, nextPin);
          }

          function pulseDetailCard(el) {
            if (!el) return;
            el.style.transition = 'all 0.2s ease';
            el.style.transform = 'scale(1.02)';
            el.style.borderColor = '#0a5dc2';
            setTimeout(() => {
              el.style.transform = '';
              el.style.borderColor = '';
            }, 300);
          }

          function init3DCanvasForIndex(idx) {
            const canvas = document.getElementById('canvas3D-' + idx);
            if (!canvas || typeof THREE === 'undefined' || canvas.dataset.initialized) return;
            canvas.dataset.initialized = 'true';
            const container = canvas.parentElement;
            const width = container.clientWidth || 640;
            const height = 420;

            const scene = new THREE.Scene();
            const camera = new THREE.PerspectiveCamera(45, width / height, 0.1, 1000);
            camera.position.set(0, 0, 5);

            const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
            renderer.setSize(width, height);
            renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

            const ambientLight = new THREE.AmbientLight(0xffffff, 0.7);
            scene.add(ambientLight);

            const dirLight1 = new THREE.DirectionalLight(0x0284c7, 1.6);
            dirLight1.position.set(5, 5, 5);
            scene.add(dirLight1);

            const dirLight2 = new THREE.DirectionalLight(0x10b981, 1.2);
            dirLight2.position.set(-5, -5, -2);
            scene.add(dirLight2);

            const group = new THREE.Group();
            const brainGeo = new THREE.IcosahedronGeometry(1.4, 3);
            const brainMat = new THREE.MeshStandardMaterial({ color: 0x0284c7, roughness: 0.3, metalness: 0.2, flatShading: true });
            const brainMesh = new THREE.Mesh(brainGeo, brainMat);
            group.add(brainMesh);

            const wireMat = new THREE.MeshBasicMaterial({ color: 0x38bdf8, wireframe: true, transparent: true, opacity: 0.4 });
            const wireMesh = new THREE.Mesh(brainGeo, wireMat);
            wireMesh.scale.setScalar(1.05);
            group.add(wireMesh);

            const particleGeo = new THREE.BufferGeometry();
            const count = 100;
            const positions = new Float32Array(count * 3);
            for (let i = 0; i < count * 3; i++) {
              positions[i] = (Math.random() - 0.5) * 4.5;
            }
            particleGeo.setAttribute('position', new THREE.BufferAttribute(positions, 3));
            const particleMat = new THREE.PointsMaterial({ color: 0xf59e0b, size: 0.06, transparent: true, opacity: 0.8 });
            group.add(new THREE.Points(particleGeo, particleMat));

            scene.add(group);

            let isDragging = false;
            let previousMousePosition = { x: 0, y: 0 };
            canvas.addEventListener('mousedown', e => { isDragging = true; previousMousePosition = { x: e.clientX, y: e.clientY }; });
            window.addEventListener('mouseup', () => isDragging = false);
            canvas.addEventListener('mousemove', e => {
              if (!isDragging) return;
              group.rotation.y += (e.clientX - previousMousePosition.x) * 0.01;
              group.rotation.x += (e.clientY - previousMousePosition.y) * 0.01;
              previousMousePosition = { x: e.clientX, y: e.clientY };
            });

            let previousTouch = null;
            canvas.addEventListener('touchstart', e => { if (e.touches.length === 1) previousTouch = e.touches[0]; });
            canvas.addEventListener('touchmove', e => {
              if (!previousTouch || e.touches.length !== 1) return;
              const touch = e.touches[0];
              group.rotation.y += (touch.clientX - previousTouch.clientX) * 0.01;
              group.rotation.x += (touch.clientY - previousTouch.clientY) * 0.01;
              previousTouch = touch;
            });
            canvas.addEventListener('touchend', () => previousTouch = null);

            function animate() {
              requestAnimationFrame(animate);
              if (!isDragging && !previousTouch) {
                group.rotation.y += 0.005;
              }
              renderer.render(scene, camera);
            }
            animate();
          }

          document.addEventListener('DOMContentLoaded', () => {
            init3DCanvasForIndex(0);
          });
        </script>
        <script src="https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.min.js" onload="init3DCanvasForIndex(0)"></script>
      <% } else { %>
        <!-- CLEAN EMPTY STATE NOTICE WHEN NO NOTES ARE UPLOADED YET -->
        <div class="card border-0 shadow-sm rounded-4 p-5 bg-white text-center border mb-4">
          <div class="py-4">
            <div class="bg-primary-subtle text-primary rounded-circle d-inline-flex align-items-center justify-content-center mb-3 shadow-sm" style="width: 76px; height: 76px;">
              <i class="ri-file-text-line display-5"></i>
            </div>
            <h4 class="fw-bold text-dark mb-2">No Study Notes Uploaded Yet</h4>
            <p class="text-secondary small mb-0 mx-auto leading-relaxed" style="max-width: 480px;">There are currently no study notes or PDF guides published for <%= category.name %>. Study materials will appear here once updated by faculty.</p>
          </div>
        </div>
      <% } %>

      <script>
        function toggleInPageFullscreen(cardId) {
          const card = document.getElementById(cardId);
          if (!card) return;
          const btn = card.querySelector('.fullscreen-toggle-btn');
          if (card.classList.contains('note-card-fullscreen')) {
            card.classList.remove('note-card-fullscreen');
            document.body.style.overflow = '';
            if (btn) btn.innerHTML = '<i class="ri-expand-arrows-line me-1"></i> Expand Full Page';
          } else {
            card.classList.add('note-card-fullscreen');
            document.body.style.overflow = 'hidden';
            if (btn) btn.innerHTML = '<i class="ri-contract-arrows-line me-1"></i> Exit Full Page';
          }
        }
      </script>
    <% } %>



    <!-- 6. CROSS-SECTIONS -->
    <% if (activeSection === 'cross-sections') { %>
      <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
        <div>
          <h3 class="fw-bold text-dark mb-1"><i class="ri-layout-grid-line text-primary me-2"></i>Coronal, Sagittal & Transverse Cross-Sections</h3>
        </div>
      </div>

      <div class="row g-4">
        <% (interactiveData.crossSections || []).forEach(cs => { %>
          <div class="col-md-6 col-lg-4">
            <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden bg-white border">
              <img src="<%= cs.image %>" alt="<%= cs.title %>" class="card-img-top" style="height: 220px; object-fit: cover;">
              <div class="card-body p-4">
                <span class="badge bg-primary-subtle text-primary font-weight-bold px-3 py-1 rounded-pill small mb-2"><%= cs.view %></span>
                <h5 class="fw-bold text-dark mb-3"><%= cs.title %></h5>
                <div class="fw-bold text-dark small mb-2">Identified Structures:</div>
                <div class="d-flex flex-wrap gap-1.5">
                  <% cs.labels.forEach(lbl => { %>
                    <span class="badge bg-light text-dark border rounded-pill px-2.5 py-1 small"><%= lbl %></span>
                  <% }) %>
                </div>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>

    <!-- 7. MRIS -->
    <% if (activeSection === 'mri-scans') { %>
      <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
        <div>
          <h3 class="fw-bold text-dark mb-1"><i class="ri-pulse-line text-success me-2"></i>Clinical MRI & Scan Diagnostic Desk</h3>
        </div>
      </div>

      <% (interactiveData.mriScans || []).forEach(mri => { %>
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white border mb-4">
          <h5 class="fw-bold text-dark mb-3"><%= mri.title %></h5>
          <div class="row g-4">
            <div class="col-md-6 text-center">
              <div class="rounded-4 overflow-hidden border mb-3">
                <img src="<%= mri.normalImg %>" alt="Normal Scan" class="img-fluid w-100" style="height: 240px; object-fit: cover;">
              </div>
              <span class="badge bg-success-subtle text-success font-weight-bold px-3 py-1.5 rounded-pill mb-2">Normal Anatomical Scan</span>
              <p class="text-secondary small mb-0"><%= mri.anatomyDesc %></p>
            </div>

            <div class="col-md-6 text-center">
              <div class="rounded-4 overflow-hidden border mb-3">
                <img src="<%= mri.pathologyImg %>" alt="Pathology Scan" class="img-fluid w-100" style="height: 240px; object-fit: cover;">
              </div>
              <span class="badge bg-danger-subtle text-danger font-weight-bold px-3 py-1.5 rounded-pill mb-2">Pathology Lesion Scan</span>
              <p class="text-secondary small mb-0"><%= mri.mriDesc %></p>
            </div>
          </div>
        </div>
      <% }) %>
    <% } %>

    <!-- 8. STROKE & PATHOLOGY MODELS -->
    <% if (activeSection === 'stroke-models') { %>
      <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
        <div>
          <h3 class="fw-bold text-dark mb-1"><i class="ri-heart-pulse-line text-danger me-2"></i>Stroke & Clinical Pathology Case Models</h3>
        </div>
      </div>

      <div class="row g-4">
        <% (interactiveData.clinicalCases || []).forEach(cc => { %>
          <div class="col-md-6">
            <div class="card h-100 border-0 shadow-sm rounded-4 p-4 bg-white border">
              <span class="badge bg-danger-subtle text-danger font-weight-bold px-3 py-1.5 rounded-pill w-fit mb-3">
                Clinical Case Model
              </span>
              <h5 class="fw-bold text-dark mb-3"><%= cc.title %></h5>
              
              <div class="bg-light rounded-3 p-3 mb-3 border">
                <div class="fw-bold text-dark small mb-1"><i class="ri-user-search-line me-1 text-primary"></i> Patient Presentation:</div>
                <p class="text-secondary small mb-0"><%= cc.history %></p>
              </div>

              <div class="fw-bold text-dark small mb-2"><i class="ri-stethoscope-line me-1 text-warning"></i> Diagnostic Findings:</div>
              <ul class="list-unstyled mb-3">
                <% cc.findings.forEach(f => { %>
                  <li class="small text-secondary mb-1.5 d-flex align-items-center"><i class="ri-checkbox-circle-fill text-danger me-2"></i> <%= f %></li>
                <% }) %>
              </ul>

              <div class="bg-primary-subtle text-primary rounded-3 p-3 mt-auto border border-primary-subtle">
                <div class="fw-bold small mb-1"><i class="ri-heart-pulse-fill me-1"></i> Physiotherapy Rehab Protocol:</div>
                <div class="small fw-semibold"><%= cc.rehabPlan %></div>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>

    <% } %>
  </div>
</div>

<script>
  const hotspotsData = <%- JSON.stringify(interactiveData.hotspots || []) %>;

  function showHotspotInfo(id) {
    const hs = hotspotsData.find(item => item.id === id);
    if (!hs) return;
    document.getElementById('hsId').innerText = hs.id;
    document.getElementById('hsTitle').innerText = hs.title;
    document.getElementById('hsDesc').innerText = hs.description;
    document.getElementById('hsNerve').innerText = hs.nerveSupply;
    document.getElementById('hsAction').innerText = hs.action;
  }
</script>
