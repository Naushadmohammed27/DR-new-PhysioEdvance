<%
  // Fallback so page still works if contactSettings is null (e.g. DB error)
  const cs = contactSettings || {};
  const heroBadge    = cs.heroBadge    || 'Student & Academic Support';
  const heroTitle    = cs.heroTitle    || "We'd Love to Hear From You";
  const heroSubtitle = cs.heroSubtitle || 'Have questions about BPT courses, curriculum notes, live workshops, or partnership opportunities? Reach out and our team will get back to you within 24 hours.';
  const sectionBadge = cs.sectionBadge || 'Contact Channels';
  const heading      = cs.heading      || 'Get Direct Guidance';
  const description  = cs.description  || 'Whether you are a student looking for subject clarification or a faculty member interested in collaborating, we are just a message away.';
  const email        = cs.email        || 'support@physioedvance.com';
  const phone        = cs.phone        || '+91 99643 81417';
  const whatsappNum  = cs.whatsappNum  || '919964381417';
  const locationName = cs.locationName || 'PhysioEdvance Headquarters';
  const locationCity = cs.locationCity || 'Bengaluru, Karnataka, India';
  const guaranteeTitle = cs.guaranteeTitle || 'Fast 24-Hour Response Guarantee';
  const guaranteeText  = cs.guaranteeText  || 'Our academic advisors respond to all student and faculty inquiries within one business day.';
  const card1Icon  = cs.card1Icon  || 'ri-flash-element-line';
  const card1Title = cs.card1Title || 'Quick 1-Minute Setup';
  const card1Text  = cs.card1Text  || 'Physiotherapy students can register and gain instant access to free subject notes.';
  const card2Icon  = cs.card2Icon  || 'ri-user-star-line';
  const card2Title = cs.card2Title || 'Expert Faculty Guidance';
  const card2Text  = cs.card2Text  || 'Mentorship and learning support provided directly by practicing BPT & MPT clinicians.';
  const card3Icon  = cs.card3Icon  || 'ri-shield-check-line';
  const card3Title = cs.card3Title || '100% Free & Secure';
  const card3Text  = cs.card3Text  || 'Free open learning platform built exclusively for physiotherapy students across India.';
  const formTitle   = cs.formTitle   || 'Leave Your Details';
  const formSubtext = cs.formSubtext || "Fill out the quick form — we'll handle the rest.";
  const formBtnText = cs.formBtnText || 'Submit Request';
%>

<!-- ============ HERO HEADER ============ -->
<section class="pe-contact-hero position-relative py-5 text-center" style="background: linear-gradient(180deg, #0a5dc2 0%, #0369a1 100%); color: #ffffff;">
  <div class="container position-relative z-2 py-4">
    <span class="badge bg-warning text-dark font-weight-bold text-uppercase px-3.5 py-2 rounded-pill mb-3 shadow-sm" style="font-size: 0.8rem; letter-spacing: 0.05em;">
      <i class="ri-headphone-fill me-1"></i> <%= heroBadge %>
    </span>
    <h1 class="display-5 font-weight-bold text-white mb-3"><%= heroTitle %></h1>
    <p class="text-white-75 mx-auto lead mb-0" style="max-width: 650px; font-size: 1.1rem; line-height: 1.7;">
      <%= heroSubtitle %>
    </p>
  </div>
</section>

<!-- ============ CONTACT MAIN SECTION ============ -->
<section class="pe-section bg-light-subtle py-5">
  <div class="container py-3">
    <div class="row g-5 align-items-stretch">
      <!-- Left Column: Contact Methods & Support Cards -->
      <div class="col-lg-5 d-flex flex-column justify-content-between">
        <div>
          <span class="badge bg-primary-subtle text-primary font-weight-bold text-uppercase px-3 py-1.5 rounded-pill mb-3" style="font-size: 0.75rem;">
            <i class="ri-map-pin-user-line me-1"></i> <%= sectionBadge %>
          </span>
          <h2 class="fw-bold text-dark display-6 mb-3" style="letter-spacing: -0.02em;">
            <%= heading %>
          </h2>
          <p class="text-muted leading-relaxed mb-4" style="font-size: 1rem;">
            <%= description %>
          </p>

          <!-- Contact Cards Grid -->
          <div class="d-flex flex-column gap-3 mb-4">
            <!-- Email Card -->
            <div class="p-3.5 bg-white rounded-4 border shadow-sm d-flex align-items-center gap-3 transition-all">
              <div class="pe-category-icon m-0 flex-shrink-0" style="width: 48px; height: 48px; font-size: 1.4rem; background: rgba(10, 93, 194, 0.1); color: #0a5dc2; border-radius: 14px; display: flex; align-items: center; justify-content: center;">
                <i class="ri-mail-send-fill"></i>
              </div>
              <div>
                <div class="text-muted small fw-bold text-uppercase mb-0.5" style="letter-spacing: 0.04em;">Official Email</div>
                <a href="mailto:<%= email %>" class="fw-bold text-dark text-decoration-none fs-6">
                  <%= email %>
                </a>
              </div>
            </div>

            <!-- Phone / WhatsApp Card -->
            <div class="p-3.5 bg-white rounded-4 border shadow-sm d-flex align-items-center gap-3 transition-all">
              <div class="pe-category-icon m-0 flex-shrink-0" style="width: 48px; height: 48px; font-size: 1.4rem; background: rgba(16, 185, 129, 0.1); color: #10b981; border-radius: 14px; display: flex; align-items: center; justify-content: center;">
                <i class="ri-whatsapp-fill"></i>
              </div>
              <div class="flex-grow-1">
                <div class="text-muted small fw-bold text-uppercase mb-0.5" style="letter-spacing: 0.04em;">Phone & WhatsApp</div>
                <div class="fw-bold text-dark fs-6"><%= phone %></div>
              </div>
              <a href="https://wa.me/<%= whatsappNum %>" target="_blank" rel="noopener" class="btn btn-sm btn-success rounded-pill px-3 fw-bold" title="Open WhatsApp Chat">
                <i class="ri-whatsapp-line me-1"></i> Chat
              </a>
            </div>

            <!-- Office Location Card -->
            <div class="p-3.5 bg-white rounded-4 border shadow-sm d-flex align-items-center gap-3 transition-all">
              <div class="pe-category-icon m-0 flex-shrink-0" style="width: 48px; height: 48px; font-size: 1.4rem; background: rgba(245, 158, 11, 0.1); color: #f59e0b; border-radius: 14px; display: flex; align-items: center; justify-content: center;">
                <i class="ri-building-4-fill"></i>
              </div>
              <div>
                <div class="text-muted small fw-bold text-uppercase mb-0.5" style="letter-spacing: 0.04em;">Academic Desk</div>
                <div class="fw-bold text-dark fs-6"><%= locationName %></div>
                <span class="text-muted small"><%= locationCity %></span>
              </div>
            </div>
          </div>
        </div>

        <!-- Fast Response Guarantee Badge -->
        <div class="p-3.5 bg-primary-subtle rounded-4 border border-primary-subtle text-primary">
          <div class="d-flex align-items-center gap-2 mb-1">
            <i class="ri-shield-check-fill fs-5"></i>
            <span class="fw-bold"><%= guaranteeTitle %></span>
          </div>
          <p class="small mb-0 opacity-85">
            <%= guaranteeText %>
          </p>
        </div>
      </div>

      <!-- Right Column: Executive Form Card -->
      <div class="col-lg-7">
        <div class="card border-0 shadow-lg rounded-4 overflow-hidden bg-white" style="box-shadow: 0 20px 40px rgba(15, 23, 42, 0.08) !important;">
          <!-- Top Accent Gradient Line -->
          <div style="height: 5px; background: linear-gradient(90deg, #0a5dc2 0%, #38bdf8 100%);"></div>

          <div class="card-body p-4 p-md-5">
            <div class="d-flex align-items-center justify-content-between mb-4">
              <div>
                <h4 class="fw-bold text-dark mb-1"><%= formTitle %></h4>
                <p class="text-muted small mb-0"><%= formSubtext %></p>
              </div>
              <span class="badge bg-light text-secondary rounded-pill px-3 py-2 border small">
                <i class="ri-lock-2-line me-1 text-primary"></i> 100% Confidential
              </span>
            </div>

            <form action="/contact" method="POST">
              <div class="mb-3">
                <label class="form-label fw-bold text-dark small">
                  <i class="ri-user-line text-primary me-1"></i> Full Name
                </label>
                <input type="text" name="name" class="form-control form-control-lg bg-light-subtle border-light-subtle" placeholder="e.g. Dr. Rahul Sharma" required>
              </div>

              <div class="row g-3 mb-3">
                <div class="col-md-6">
                  <label class="form-label fw-bold text-dark small">
                    <i class="ri-phone-line text-primary me-1"></i> Phone Number
                  </label>
                  <input type="tel" name="phone" class="form-control form-control-lg bg-light-subtle border-light-subtle" placeholder="+91 9XXXXXXXXX" required>
                </div>
                <div class="col-md-6">
                  <label class="form-label fw-bold text-dark small">
                    <i class="ri-mail-line text-primary me-1"></i> Email Address <span class="text-muted fw-normal">(Optional)</span>
                  </label>
                  <input type="email" name="email" class="form-control form-control-lg bg-light-subtle border-light-subtle" placeholder="name@example.com">
                </div>
              </div>

              <div class="row g-3 mb-3">
                <div class="col-md-6">
                  <label class="form-label fw-bold text-dark small">
                    <i class="ri-book-open-line text-primary me-1"></i> Academic Year / Program Interest
                  </label>
                  <select name="service_type" class="form-select form-select-lg bg-light-subtle border-light-subtle" style="font-size: 0.95rem;">
                    <option value="BPT 1st Year (Foundation &amp; Osteology)">BPT 1st Year (Foundation &amp; Osteology)</option>
                    <option value="BPT 2nd Year (Pathology &amp; Biomechanics)">BPT 2nd Year (Pathology &amp; Biomechanics)</option>
                    <option value="BPT 3rd Year (Medicine, Surgery &amp; Ortho)">BPT 3rd Year (Medicine, Surgery &amp; Ortho)</option>
                    <option value="BPT 4th Year (Neurology, Sports &amp; Rehab)">BPT 4th Year (Neurology, Sports &amp; Rehab)</option>
                    <option value="Live Classes &amp; Interactive Workshops">Live Classes &amp; Interactive Workshops</option>
                    <option value="General Academic Inquiry">General Academic Inquiry</option>
                  </select>
                </div>

                <div class="col-md-6">
                  <label class="form-label fw-bold text-dark small">
                    <i class="ri-chat-1-line text-primary me-1"></i> Request Type
                  </label>
                  <select name="request_type" class="form-select form-select-lg bg-light-subtle border-light-subtle" style="font-size: 0.95rem;">
                    <option value="Request a Call Back" selected>Request a Call Back</option>
                    <option value="Book Academic Guidance Session">Book Academic Guidance Session</option>
                    <option value="Library &amp; Notes Access Help">Library &amp; Notes Access Help</option>
                    <option value="General Support Inquiry">General Support Inquiry</option>
                  </select>
                </div>
              </div>

              <div class="mb-4">
                <label class="form-label fw-bold text-dark small">
                  <i class="ri-chat-3-line text-primary me-1"></i> Message <span class="text-muted fw-normal">(Optional)</span>
                </label>
                <textarea name="message" rows="3" class="form-control bg-light-subtle border-light-subtle" placeholder="Write any specific query or question..."></textarea>
              </div>

              <button type="submit" class="btn btn-primary btn-lg w-100 rounded-pill py-3 fw-bold shadow-sm" style="background: linear-gradient(135deg, #0a5dc2 0%, #0369a1 100%); border: none;">
                <i class="ri-send-plane-fill me-2"></i> <%= formBtnText %>
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ============ BOTTOM QUICK SUPPORT HIGHLIGHTS ============ -->
<section class="pe-section bg-white border-top py-5">
  <div class="container py-2">
    <div class="row g-4 text-center">
      <div class="col-md-4">
        <div class="p-3">
          <div class="pe-category-icon mx-auto mb-3" style="width: 54px; height: 54px; font-size: 1.5rem; background: rgba(10, 93, 194, 0.1); color: #0a5dc2; border-radius: 16px; display: flex; align-items: center; justify-content: center;">
            <i class="<%= card1Icon %>"></i>
          </div>
          <h6 class="fw-bold text-dark mb-1"><%= card1Title %></h6>
          <p class="text-muted small mb-0"><%= card1Text %></p>
        </div>
      </div>

      <div class="col-md-4">
        <div class="p-3">
          <div class="pe-category-icon mx-auto mb-3" style="width: 54px; height: 54px; font-size: 1.5rem; background: rgba(16, 185, 129, 0.1); color: #10b981; border-radius: 16px; display: flex; align-items: center; justify-content: center;">
            <i class="<%= card2Icon %>"></i>
          </div>
          <h6 class="fw-bold text-dark mb-1"><%= card2Title %></h6>
          <p class="text-muted small mb-0"><%= card2Text %></p>
        </div>
      </div>

      <div class="col-md-4">
        <div class="p-3">
          <div class="pe-category-icon mx-auto mb-3" style="width: 54px; height: 54px; font-size: 1.5rem; background: rgba(245, 158, 11, 0.1); color: #f59e0b; border-radius: 16px; display: flex; align-items: center; justify-content: center;">
            <i class="<%= card3Icon %>"></i>
          </div>
          <h6 class="fw-bold text-dark mb-1"><%= card3Title %></h6>
          <p class="text-muted small mb-0"><%= card3Text %></p>
        </div>
      </div>
    </div>
  </div>
</section>
