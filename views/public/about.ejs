<style>
  /* Base & Utility Typography */
  .pe-font-heading {
    font-family: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  }
  
  /* Hero Gradient & Animated Glow background */
  .pe-about-hero {
    background: radial-gradient(circle at 15% 30%, rgba(2, 132, 199, 0.4) 0%, transparent 45%),
                radial-gradient(circle at 85% 70%, rgba(14, 165, 233, 0.3) 0%, transparent 50%),
                linear-gradient(135deg, #0b2545 0%, #0a5dc2 55%, #0284c7 100%);
  }

  .pe-glass-badge {
    background: rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.25);
    color: #ffffff;
  }

  .pe-gradient-text {
    background: linear-gradient(135deg, #ffffff 0%, #bae6fd 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .pe-gradient-accent-text {
    background: linear-gradient(135deg, #38bdf8 0%, #818cf8 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  /* Card Hover Micro-Interactions */
  .pe-hover-lift {
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.35s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.35s ease;
  }
  .pe-hover-lift:hover {
    transform: translateY(-6px);
    box-shadow: 0 20px 35px -10px rgba(10, 93, 194, 0.12) !important;
  }

  /* Timeline Enhancements */
  .pe-timeline-track {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 20px;
    width: 4px;
    background: linear-gradient(180deg, #0a5dc2 0%, #0284c7 40%, #f59e0b 70%, #10b981 100%);
    border-radius: 4px;
  }
  @media (min-width: 768px) {
    .pe-timeline-track {
      left: 24px;
    }
  }

  .pe-node-ring {
    box-shadow: 0 0 0 5px rgba(10, 93, 194, 0.15);
  }

  .pe-scrollable-quote::-webkit-scrollbar { width: 5px; }
  .pe-scrollable-quote::-webkit-scrollbar-track { background: #f1f5f9; border-radius: 10px; }
  .pe-scrollable-quote::-webkit-scrollbar-thumb { background: #0a5dc2; border-radius: 10px; }
  .pe-scrollable-quote::-webkit-scrollbar-thumb:hover { background: #0284c7; }

  /* Feature Icons Glow */
  .pe-icon-glow-primary {
    background: rgba(10, 93, 194, 0.1);
    color: #0a5dc2;
    box-shadow: 0 0 20px rgba(10, 93, 194, 0.15);
  }
  .pe-icon-glow-warning {
    background: rgba(245, 158, 11, 0.12);
    color: #d97706;
    box-shadow: 0 0 20px rgba(245, 158, 11, 0.15);
  }
  .pe-icon-glow-success {
    background: rgba(16, 185, 129, 0.12);
    color: #059669;
    box-shadow: 0 0 20px rgba(16, 185, 129, 0.15);
  }

  /* Decorative Divider */
  .pe-heading-line {
    width: 60px;
    height: 4px;
    background: linear-gradient(90deg, #0a5dc2 0%, #38bdf8 100%);
    border-radius: 2px;
  }

  /* Floating decorative watermark icons */
  .pe-watermark-icon {
    position: absolute;
    right: -15px;
    bottom: -15px;
    font-size: 8rem;
    opacity: 0.04;
    pointer-events: none;
  }
</style>

<!-- ============ HERO HEADER SECTION ============ -->
<section class="pe-about-hero text-center py-5 text-white position-relative overflow-hidden">
  <!-- Subtle Background Grid Pattern -->
  <div class="position-absolute inset-0 opacity-10" style="background-image: radial-gradient(rgba(255,255,255,0.4) 1px, transparent 1px); background-size: 24px 24px;"></div>

  <div class="container py-4 py-md-5 position-relative z-1">
    
    <!-- Glass Badge -->
    <div class="d-inline-flex align-items-center gap-2 pe-glass-badge px-3 py-1.5 rounded-pill mb-3 shadow-sm">
      <i class="ri-heart-pulse-fill text-warning fs-6"></i>
      <span class="fw-bold text-uppercase tracking-wider" style="font-size: 0.78rem; letter-spacing: 0.08em;">About PhysioEdvance</span>
    </div>

    <!-- Main Title -->
    <h1 class="text-white fw-extrabold display-4 mb-3 pe-font-heading px-2">
      Empowering the Next Generation of <br class="d-none d-md-inline"><span class="pe-gradient-text">Physiotherapists</span>
    </h1>

    <!-- Hero Tagline -->
    <p class="text-white-75 mx-auto lead px-3 mb-4" style="max-width: 720px; font-size: 1.2rem; line-height: 1.7;">
      PhysioEdvance is a dedicated digital learning ecosystem created specifically for BPT & MPT physiotherapy students across India.
    </p>

    <!-- Stat Ribbon Bar -->
    <div class="row justify-content-center g-3 pt-3" style="max-width: 900px; margin: 0 auto;">
      <div class="col-6 col-md-3">
        <div class="pe-glass-badge p-3 rounded-4 text-center">
          <div class="fw-extrabold fs-4 text-white mb-0">BPT 1-4</div>
          <div class="text-white-75 text-uppercase font-weight-semibold" style="font-size: 0.72rem; letter-spacing: 0.05em;">Academic Years</div>
        </div>
      </div>
      <div class="col-6 col-md-3">
        <div class="pe-glass-badge p-3 rounded-4 text-center">
          <div class="fw-extrabold fs-4 text-warning mb-0">3D WebGL</div>
          <div class="text-white-75 text-uppercase font-weight-semibold" style="font-size: 0.72rem; letter-spacing: 0.05em;">Rotatable Models</div>
        </div>
      </div>
      <div class="col-6 col-md-3">
        <div class="pe-glass-badge p-3 rounded-4 text-center">
          <div class="fw-extrabold fs-4 text-white mb-0">HD Video</div>
          <div class="text-white-75 text-uppercase font-weight-semibold" style="font-size: 0.72rem; letter-spacing: 0.05em;">Stream & Notes</div>
        </div>
      </div>
      <div class="col-6 col-md-3">
        <div class="pe-glass-badge p-3 rounded-4 text-center">
          <div class="fw-extrabold fs-4 text-info mb-0">1 Shared</div>
          <div class="text-white-75 text-uppercase font-weight-semibold" style="font-size: 0.72rem; letter-spacing: 0.05em;">Clinical Vision</div>
        </div>
      </div>
    </div>

  </div>
</section>

<!-- ============ ABOUT US MAIN PURPOSE & VISION SECTION ============ -->
<section class="pe-about-intro py-5 bg-white border-bottom position-relative overflow-hidden">
  <div class="container py-4">
    
    <!-- Section Header -->
    <div class="text-center mb-5">
      <span class="badge bg-primary-subtle text-primary font-weight-bold text-uppercase px-3 py-1.5 rounded-pill mb-2" style="font-size: 0.78rem; letter-spacing: 0.08em;">
        <i class="ri-compass-3-line me-1"></i> Our Purpose & Vision
      </span>
      <h2 class="fw-bold display-6 mb-2 text-slate-900" style="color: #0f172a;">About PhysioEdvance</h2>
      <p class="text-muted mx-auto lead-sm" style="max-width: 650px; font-size: 1.08rem;">
        Connecting knowledge with understanding, and understanding with clinical practice.
      </p>
      <div class="pe-heading-line mx-auto mt-3"></div>
    </div>

    <!-- Centered Purpose Card -->
    <div class="row justify-content-center">
      <div class="col-lg-10 col-xl-9">
        <div class="card border-0 shadow-lg rounded-4 p-4 p-md-5 bg-white overflow-hidden pe-hover-lift position-relative" style="border: 1px solid rgba(10, 93, 194, 0.12) !important;">
          <div class="pe-watermark-icon text-primary"><i class="ri-compass-3-line"></i></div>
          
          <!-- Top Bar -->
          <div class="d-flex align-items-center justify-content-between mb-4 pb-3 border-bottom flex-wrap gap-2">
            <span class="badge bg-primary text-white font-weight-bold px-3 py-1.5 rounded-pill shadow-sm" style="font-size: 0.78rem; letter-spacing: 0.05em;">
              <i class="ri-shield-star-line me-1"></i> Educational Ecosystem
            </span>
            <span class="text-primary font-weight-bold small text-uppercase" style="letter-spacing: 0.1em; font-size: 0.82rem;">
              LEARN &bull; UNDERSTAND &bull; ADVANCE
            </span>
          </div>

          <!-- Card Content Body -->
          <div class="pe-about-text text-secondary" style="font-size: 1.08rem; line-height: 1.9; color: #334155;">
            <p class="mb-4">
              <strong class="text-slate-900 fw-bold" style="color: #0f172a;">PhysioEdvance</strong> is an edtech platform dedicated to physiotherapy education, created with one clear purpose—to make quality physiotherapy learning more accessible, structured, understandable, and relevant to today's students.
            </p>

            <p class="mb-4">
              Physiotherapy is a constantly evolving healthcare profession. New research, clinical approaches, technologies, and evidence continue to shape the way physiotherapists learn and practice. Yet, for many students, learning physiotherapy can still feel fragmented.
            </p>

            <p class="mb-4">
              PhysioEdvance was created to bring that learning journey together. We envision PhysioEdvance as a one-stop learning ecosystem where physiotherapy students can learn, understand, revise, explore, and advance throughout their academic journey.
            </p>

            <p class="mb-0">
              From foundational subjects to core physiotherapy education, from theoretical concepts to clinical application, our goal is to create educational content that connects knowledge with understanding and understanding with practice.
            </p>
          </div>

          <!-- Bottom Footer -->
          <div class="pt-4 mt-4 border-top d-flex align-items-center justify-content-between text-muted flex-wrap gap-2" style="font-size: 0.85rem;">
            <span class="fw-bold text-primary d-flex align-items-center">
              <i class="ri-heart-pulse-fill me-1.5 fs-5"></i> PhysioEdvance Platform
            </span>
            <span class="fw-bold text-uppercase text-muted" style="letter-spacing: 0.06em;">
              Edtech for Physiotherapy Education
            </span>
          </div>

        </div>
      </div>
    </div>

  </div>
</section>

<!-- ============ LEADERSHIP MESSAGES SECTION ============ -->
<% if (typeof aboutStatements !== 'undefined' && aboutStatements.length > 0) { %>
<section class="pe-section bg-light py-5 border-bottom position-relative">
  <div class="container py-2">
    
    <!-- Section Header -->
    <div class="pe-section-head text-center mb-5">
      <span class="badge bg-primary-subtle text-primary font-weight-bold text-uppercase px-3 py-1.5 rounded-pill mb-2" style="font-size: 0.78rem; letter-spacing: 0.08em;">
        <i class="ri-user-star-line me-1"></i> Leadership & Philosophy
      </span>
      <h2 class="pe-section-title font-weight-bold display-6 mb-2 text-dark">Leadership Messages</h2>
      <p class="text-muted mx-auto" style="max-width: 620px; font-size: 1.08rem;">
        Insights, philosophy, and learning vision from the leaders building PhysioEdvance.
      </p>
      <div class="pe-heading-line mx-auto mt-3"></div>
    </div>

    <div class="row g-4 justify-content-center">
      <% aboutStatements.forEach((stmt, sIdx) => { %>
        <div class="col-12">
          <div class="card border-0 shadow-lg rounded-4 overflow-hidden bg-white pe-hover-lift transition-all position-relative" style="border: 1px solid rgba(10, 93, 194, 0.1) !important;">
            <div class="row g-0 align-items-stretch">
              
              <!-- LEFT COLUMN: PHOTO, NAME & QUALIFICATIONS -->
              <div class="col-md-4 col-lg-3 p-4 text-center text-white d-flex flex-column align-items-center justify-content-center position-relative overflow-hidden" style="background: linear-gradient(135deg, #0b2545 0%, #0a5dc2 60%, #0284c7 100%); min-height: 250px;">
                <div class="position-relative d-inline-block mb-3">
                  <img src="<%= stmt.photo || '/images/team/default-avatar.png' %>" alt="<%= stmt.name %>" class="rounded-circle border border-4 border-white shadow-lg" style="width: 120px; height: 120px; object-fit: cover;" onerror="this.src='https://ui-avatars.com/api/?name=<%= encodeURIComponent(stmt.name) %>&background=0a5dc2&color=fff&size=256'">
                  <span class="position-absolute bottom-0 end-0 bg-warning text-dark rounded-circle d-flex align-items-center justify-content-center border border-2 border-white shadow" style="width: 30px; height: 30px; font-size: 0.9rem;" title="Verified Leadership Board">
                    <i class="ri-star-fill"></i>
                  </span>
                </div>
                <h4 class="fw-bold text-white mb-1" style="font-size: 1.25rem;"><%= stmt.name %></h4>
                <span class="badge bg-warning text-dark font-weight-bold px-3 py-1.5 rounded-pill mb-2 shadow-sm" style="font-size: 0.82rem;">
                  <%= stmt.designation || stmt.role %>
                </span>
                <% if (stmt.qualification) { %>
                  <div class="text-white-75 small font-weight-semibold" style="font-size: 0.82rem;"><%= stmt.qualification %></div>
                <% } %>
              </div>

              <!-- RIGHT COLUMN: SCROLLABLE LEADERSHIP MESSAGE CONTENT -->
              <div class="col-md-8 col-lg-9 p-4 p-lg-5 d-flex flex-column justify-content-between bg-white">
                <div>
                  <div class="d-flex align-items-center justify-content-between mb-3">
                    <div class="pe-quote-mark text-primary opacity-25" style="font-size: 2.8rem; line-height: 1;">
                      <i class="ri-double-quotes-l"></i>
                    </div>
                    <span class="badge bg-primary-subtle text-primary border rounded-pill px-3 py-1 font-weight-semibold" style="font-size: 0.78rem;">
                      <i class="ri-shield-check-line me-1"></i> Official Leadership Statement
                    </span>
                  </div>

                  <!-- SCROLLABLE STATEMENT MESSAGE CONTAINER -->
                  <div class="pe-scrollable-quote text-dark font-weight-normal mb-3" style="max-height: 240px; overflow-y: auto; padding-right: 14px; font-style: italic; line-height: 1.85; font-size: 1.02rem; color: #1e293b;">
                    “<%= stmt.statement || stmt.bio || 'PhysioEdvance aims to be a one-stop learning solution for physiotherapy students across India.' %>”
                  </div>
                </div>

                <!-- Footer info -->
                <div class="border-top pt-3 mt-2 d-flex align-items-center justify-content-between flex-wrap gap-2">
                  <span class="text-muted small font-weight-semibold" style="font-size: 0.82rem;">
                    <i class="ri-building-line text-primary me-1"></i> PhysioEdvance Board of Directors
                  </span>
                  <span class="text-primary font-weight-bold small" style="font-size: 0.82rem;">
                    Verified Leader Profile <i class="ri-arrow-right-s-line"></i>
                  </span>
                </div>
              </div>

            </div>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<!-- ============ THE STORY BEHIND PHYSIOEDVANCE TIMELINE SECTION ============ -->
<section class="pe-story-section py-5 bg-white border-bottom position-relative">
  <div class="container py-4">
    
    <!-- Section Header -->
    <div class="text-center mb-5">
      <span class="badge bg-primary-subtle text-primary font-weight-bold text-uppercase px-3 py-1.5 rounded-pill mb-2" style="font-size: 0.78rem; letter-spacing: 0.08em;">
        <i class="ri-history-line me-1"></i> Our Origin & Journey
      </span>
      <h2 class="fw-bold display-6 mb-2 text-slate-900" style="color: #0a5dc2;">The Story Behind PhysioEdvance</h2>
      <p class="text-uppercase fw-bold text-muted mb-0" style="font-size: 0.88rem; letter-spacing: 0.12em;">
        A Journey of People, Purpose, and Possibilities (2019 &ndash; 2026)
      </p>
      <div class="pe-heading-line mx-auto mt-3"></div>
    </div>

    <!-- Vertical Timeline Container -->
    <div class="row justify-content-center">
      <div class="col-lg-10 col-xl-9">
        
        <div class="pe-web-timeline position-relative ps-4 ps-md-5 d-flex flex-column gap-4 ms-1 ms-md-3">
          
          <!-- Continuous Timeline Vertical Axis -->
          <div class="pe-timeline-track"></div>

          <!-- 2019 Milestone -->
          <div class="pe-timeline-node position-relative">
            <div class="pe-node-dot position-absolute top-0 start-0 translate-middle bg-primary text-white rounded-circle d-flex align-items-center justify-content-center shadow-lg pe-node-ring" style="width: 42px; height: 42px; left: -2px !important; font-size: 1.15rem; z-index: 2;">
              <i class="ri-seedling-fill text-warning"></i>
            </div>
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white pe-hover-lift ms-3" style="border: 1px solid rgba(10, 93, 194, 0.1) !important;">
              <div class="d-flex align-items-center gap-2.5 mb-2.5 flex-wrap">
                <span class="badge bg-primary text-white font-weight-bold px-3 py-1.5 rounded-pill shadow-sm" style="font-size: 0.82rem;">2019</span>
                <h5 class="fw-bold text-slate-900 mb-0" style="font-size: 1.15rem; color: #0f172a;">THE SEED</h5>
              </div>
              <p class="text-secondary mb-0" style="font-size: 1.02rem; line-height: 1.8; color: #334155;">
                A thought took root &ndash; <em>&ldquo;What if we could create something meaningful for physiotherapy education?&rdquo;</em> It was just an idea, shared in conversations with my mentor and my students. The seed of PhysioEdvance was planted.
              </p>
            </div>
          </div>

          <!-- 2021 Milestone -->
          <div class="pe-timeline-node position-relative">
            <div class="pe-node-dot position-absolute top-0 start-0 translate-middle bg-info text-white rounded-circle d-flex align-items-center justify-content-center shadow-lg pe-node-ring" style="width: 42px; height: 42px; left: -2px !important; font-size: 1.15rem; z-index: 2;">
              <i class="ri-chat-smile-3-fill"></i>
            </div>
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white pe-hover-lift ms-3" style="border: 1px solid rgba(2, 132, 199, 0.1) !important;">
              <div class="d-flex align-items-center gap-2.5 mb-2.5 flex-wrap">
                <span class="badge bg-info text-white font-weight-bold px-3 py-1.5 rounded-pill shadow-sm" style="font-size: 0.82rem;">2021</span>
                <h5 class="fw-bold text-slate-900 mb-0" style="font-size: 1.15rem; color: #0f172a;">THE DREAM WAS SHARED</h5>
              </div>
              <p class="text-secondary mb-0" style="font-size: 1.02rem; line-height: 1.8; color: #334155;">
                I shared this dream with my fiancé (now my husband). I didn&rsquo;t have all the answers, but I had the vision. And sometimes, all you need is someone who says, <em>&ldquo;Let's figure it out.&rdquo;</em> The dream became a shared conversation.
              </p>
            </div>
          </div>

          <!-- 2022 Milestone -->
          <div class="pe-timeline-node position-relative">
            <div class="pe-node-dot position-absolute top-0 start-0 translate-middle bg-warning text-dark rounded-circle d-flex align-items-center justify-content-center shadow-lg pe-node-ring" style="width: 42px; height: 42px; left: -2px !important; font-size: 1.15rem; z-index: 2;">
              <i class="ri-lightbulb-fill text-dark"></i>
            </div>
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white pe-hover-lift ms-3" style="border: 1px solid rgba(245, 158, 11, 0.2) !important;">
              <div class="d-flex align-items-center gap-2.5 mb-2.5 flex-wrap">
                <span class="badge bg-warning text-dark font-weight-bold px-3 py-1.5 rounded-pill shadow-sm" style="font-size: 0.82rem;">2022</span>
                <h5 class="fw-bold text-slate-900 mb-0" style="font-size: 1.15rem; color: #0f172a;">THE TURNING POINT</h5>
              </div>
              <p class="text-secondary mb-0" style="font-size: 1.02rem; line-height: 1.8; color: #334155;">
                Life tested me in the toughest way. In the midst of loss and uncertainty, my husband said, <em>&ldquo;You have a lot to do in your life. Start working on your website.&rdquo;</em> With a pen, paper and a lot of faith, I started writing, planning and discussing with my mentor. The dream slowly turned into a plan.
              </p>
            </div>
          </div>

          <!-- 2024 Milestone -->
          <div class="pe-timeline-node position-relative">
            <div class="pe-node-dot position-absolute top-0 start-0 translate-middle bg-indigo text-white rounded-circle d-flex align-items-center justify-content-center shadow-lg pe-node-ring" style="width: 42px; height: 42px; left: -2px !important; font-size: 1.15rem; z-index: 2; background-color: #6366f1;">
              <i class="ri-file-list-3-fill"></i>
            </div>
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white pe-hover-lift ms-3" style="border: 1px solid rgba(99, 102, 241, 0.15) !important;">
              <div class="d-flex align-items-center gap-2.5 mb-2.5 flex-wrap">
                <span class="badge text-white font-weight-bold px-3 py-1.5 rounded-pill shadow-sm" style="background-color: #6366f1; font-size: 0.82rem;">2024</span>
                <h5 class="fw-bold text-slate-900 mb-0" style="font-size: 1.15rem; color: #0f172a;">THE WHITEBOARD</h5>
              </div>
              <p class="text-secondary mb-0" style="font-size: 1.02rem; line-height: 1.8; color: #334155;">
                I had my first baby, Hamdan, in my arms. The plan was in front of me &ndash; on a whiteboard. Everything I had been thinking for years was finally taking shape. I knew one thing for sure &ndash; I couldn&rsquo;t do it alone. I needed a team.
              </p>
            </div>
          </div>

          <!-- 2024-25 Milestone -->
          <div class="pe-timeline-node position-relative">
            <div class="pe-node-dot position-absolute top-0 start-0 translate-middle bg-primary text-white rounded-circle d-flex align-items-center justify-content-center shadow-lg pe-node-ring" style="width: 42px; height: 42px; left: -2px !important; font-size: 1.15rem; z-index: 2;">
              <i class="ri-team-fill"></i>
            </div>
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white pe-hover-lift ms-3" style="border: 1px solid rgba(10, 93, 194, 0.15) !important;">
              <div class="d-flex align-items-center gap-2.5 mb-3 flex-wrap">
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle font-weight-bold px-3 py-1.5 rounded-pill shadow-sm" style="font-size: 0.82rem;">2024&ndash;25</span>
                <h5 class="fw-bold text-slate-900 mb-0" style="font-size: 1.15rem; color: #0f172a;">THE PEOPLE WHO SAID YES</h5>
              </div>

              <!-- Grid of Core Believers -->
              <div class="row g-3 mb-3">
                <div class="col-sm-6">
                  <div class="p-3 bg-light rounded-3 border h-100 pe-hover-lift">
                    <div class="fw-bold text-primary small mb-1"><i class="ri-user-star-fill me-1"></i> My Mentor</div>
                    <div class="text-secondary small">The one who listened, guided, and believed from the beginning.</div>
                  </div>
                </div>
                <div class="col-sm-6">
                  <div class="p-3 bg-light rounded-3 border h-100 pe-hover-lift">
                    <div class="fw-bold text-primary small mb-1"><i class="ri-map-pin-user-fill me-1"></i> My Student (Mangalore)</div>
                    <div class="text-secondary small">The one I first discussed this idea with during a conference visit to Mangalore.</div>
                  </div>
                </div>
                <div class="col-sm-6">
                  <div class="p-3 bg-light rounded-3 border h-100 pe-hover-lift">
                    <div class="fw-bold text-primary small mb-1"><i class="ri-walk-fill me-1"></i> My Student (Mysore)</div>
                    <div class="text-secondary small">Met during online COVID teaching, told her &ldquo;Come to Mysore&rdquo; &ndash; and she came.</div>
                  </div>
                </div>
                <div class="col-sm-6">
                  <div class="p-3 bg-light rounded-3 border h-100 pe-hover-lift">
                    <div class="fw-bold text-primary small mb-1"><i class="ri-heart-pulse-fill me-1"></i> My Husband & Co-Founder</div>
                    <div class="text-secondary small">Told me to start when I didn't know where to begin. Today, my co-founder.</div>
                  </div>
                </div>
