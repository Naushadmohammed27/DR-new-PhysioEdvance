<!-- ============ EASY 4-STEP ACCESS / ONBOARDING ============ -->
<section class="pe-section bg-light py-5 border-bottom">
  <div class="container py-2">
    <div class="text-center mb-5">
      <span class="badge bg-warning-subtle text-warning-emphasis font-weight-bold text-uppercase px-3 py-1.5 rounded-pill mb-2" style="font-size: 0.78rem; letter-spacing: 0.08em; background-color: rgba(245, 158, 11, 0.15); color: #b45309;">
        <i class="ri-login-circle-line me-1"></i> Simple Onboarding
      </span>
      <h2 class="pe-section-title font-weight-bold display-6 mb-2 text-dark">Easy 4-Step Student & Faculty Access</h2>
      <p class="text-muted mx-auto" style="max-width: 620px; font-size: 1.08rem;">
        Follow these simple steps to log in, access 3D rotatable models, streaming videos, notes, and quizzes.
      </p>
      <div class="pe-heading-line mx-auto mt-3"></div>
    </div>

    <div class="row g-4">
      
      <!-- Step 1 -->
      <div class="col-md-3 col-sm-6">
        <div class="card h-100 border-0 shadow-sm rounded-4 p-4 text-center bg-white pe-hover-lift position-relative" style="border-top: 4px solid #0a5dc2 !important;">
          <div class="badge bg-primary text-white rounded-circle p-2 mx-auto mb-3 d-flex align-items-center justify-content-center shadow" style="width: 54px; height: 54px; font-size: 1.35rem; font-weight: bold;">
            1
          </div>
          <h5 class="fw-bold text-dark mb-2" style="font-size: 1.1rem;">Click Login</h5>
          <p class="text-secondary small mb-0" style="font-size: 0.92rem; line-height: 1.6;">Click the <strong>Login</strong> button on the top navigation bar or go directly to <code class="text-primary bg-primary-subtle px-2 py-0.5 rounded">/auth/login</code>.</p>
        </div>
      </div>

      <!-- Step 2 -->
      <div class="col-md-3 col-sm-6">
        <div class="card h-100 border-0 shadow-sm rounded-4 p-4 text-center bg-white pe-hover-lift position-relative" style="border-top: 4px solid #0284c7 !important;">
          <div class="badge bg-info text-white rounded-circle p-2 mx-auto mb-3 d-flex align-items-center justify-content-center shadow" style="width: 54px; height: 54px; font-size: 1.35rem; font-weight: bold;">
            2
          </div>
          <h5 class="fw-bold text-dark mb-2" style="font-size: 1.1rem;">Enter Credentials</h5>
          <p class="text-secondary small mb-0" style="font-size: 0.92rem; line-height: 1.6;">Enter your registered Email & Password or use secure Face Recognition authentication.</p>
        </div>
      </div>

      <!-- Step 3 -->
      <div class="col-md-3 col-sm-6">
        <div class="card h-100 border-0 shadow-sm rounded-4 p-4 text-center bg-white pe-hover-lift position-relative" style="border-top: 4px solid #f59e0b !important;">
          <div class="badge bg-warning text-dark rounded-circle p-2 mx-auto mb-3 d-flex align-items-center justify-content-center shadow" style="width: 54px; height: 54px; font-size: 1.35rem; font-weight: bold;">
            3
          </div>
          <h5 class="fw-bold text-dark mb-2" style="font-size: 1.1rem;">Select BPT Subject</h5>
          <p class="text-secondary small mb-0" style="font-size: 0.92rem; line-height: 1.6;">Browse BPT Year 1 to 4 subjects (Anatomy, Physiology, Neurology, Orthopedics, Electrotherapy).</p>
        </div>
      </div>

      <!-- Step 4 -->
      <div class="col-md-3 col-sm-6">
        <div class="card h-100 border-0 shadow-sm rounded-4 p-4 text-center bg-white pe-hover-lift position-relative" style="border-top: 4px solid #10b981 !important;">
          <div class="badge bg-success text-white rounded-circle p-2 mx-auto mb-3 d-flex align-items-center justify-content-center shadow" style="width: 54px; height: 54px; font-size: 1.35rem; font-weight: bold;">
            4
          </div>
          <h5 class="fw-bold text-dark mb-2" style="font-size: 1.1rem;">Start Learning</h5>
          <p class="text-secondary small mb-0" style="font-size: 0.92rem; line-height: 1.6;">Interact with 3D rotatable models, watch MP4 video streams, read study notes & solve quizzes!</p>
        </div>
      </div>

    </div>

    <!-- Direct Login Button CTA -->
    <div class="text-center mt-4 pt-2">
      <a href="/auth/login" class="btn btn-primary btn-lg rounded-pill px-4.5 py-2.5 font-weight-bold shadow pe-hover-lift" style="background: linear-gradient(135deg, #0a5dc2 0%, #0284c7 100%); border: none;">
        <i class="ri-login-box-line me-1.5"></i> Proceed to Login Page
      </a>
    </div>
  </div>
</section>

