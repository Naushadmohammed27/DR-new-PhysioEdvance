<script>
function activateYearCard(btn) {
  const allBtns = document.querySelectorAll('.pe-year-card-btn');
  allBtns.forEach(b => {
    b.classList.remove('active');
    b.setAttribute('aria-selected', 'false');
  });
  btn.classList.add('active');
  btn.setAttribute('aria-selected', 'true');
}

document.addEventListener('DOMContentLoaded', function() {
  const tabElList = document.querySelectorAll('#yearCardsNav button[data-bs-toggle="pill"]');
  tabElList.forEach(tabEl => {
    tabEl.addEventListener('shown.bs.tab', function(event) {
      activateYearCard(event.target);
    });
  });

  const hash = window.location.hash;
  if (hash) {
    let targetBtn = null;
    if (hash === '#year1' || hash === '#first-year') targetBtn = document.getElementById('btn-year-1');
    else if (hash === '#year2' || hash === '#second-year') targetBtn = document.getElementById('btn-year-2');
    else if (hash === '#year3' || hash === '#third-year') targetBtn = document.getElementById('btn-year-3');
    else if (hash === '#year4' || hash === '#fourth-year') targetBtn = document.getElementById('btn-year-4');
    else if (hash === '#yearOther' || hash === '#other-subjects') targetBtn = document.getElementById('btn-year-other');

    if (targetBtn && typeof bootstrap !== 'undefined') {
      const tab = bootstrap.Tab.getOrCreateInstance(targetBtn);
      tab.show();
      activateYearCard(targetBtn);
    }
  }
});
</script>
