<!-- ============ HERO BANNER — Ultra-Modern Premium Style ============ -->
<section class="pe-promo-banner">
  <div class="container position-relative z-2">
    <div class="row align-items-center g-3 g-lg-4 pt-1 pb-2 pt-lg-2 pb-lg-3">
      <!-- Left Column: Headline, 5 Key Offerings, CTAs, Search -->
      <div class="col-lg-6">
        <div class="pe-hero-content-box">
          <span class="badge bg-warning text-dark font-weight-bold text-uppercase px-3.5 py-2 rounded-pill mb-2.5 shadow-sm d-inline-flex align-items-center pe-hero-badge-pill" style="font-size: 0.8rem; letter-spacing: 0.05em; background-color: #f59e0b !important;">
            <i class="<%= (typeof heroSettings !== 'undefined' && heroSettings.badgeIcon) ? heroSettings.badgeIcon : 'ri-heart-pulse-fill' %> me-1"></i> <%= (typeof heroSettings !== 'undefined' && heroSettings.badgeText) ? heroSettings.badgeText : '#1 Platform for BPT Students & Physios' %>
          </span>
          <h1 class="pe-hero-title">
            <%= (typeof heroSettings !== 'undefined' && heroSettings.titlePrefix) ? heroSettings.titlePrefix : 'Advanced Physiotherapy Education,' %> <span class="pe-gradient-text"><%= (typeof heroSettings !== 'undefined' && heroSettings.titleHighlight) ? heroSettings.titleHighlight : 'All in One Place.' %></span>
          </h1>
          <p class="pe-hero-subtext">
            <%- (typeof heroSettings !== 'undefined' && heroSettings.subtext) ? heroSettings.subtext : 'Master your BPT degree with expert-led <strong>Seminars</strong>, HD <strong>Recorded Videos</strong>, interactive <strong>Workshops</strong>, real-time <strong>Live Classes</strong>, and 100% <strong>Free Courses</strong>.' %>
          </p>

          <!-- CTAs (Side-by-side & Responsive on all screens) -->
          <div class="pe-hero-cta-group mb-3 mb-md-4">
            <a href="/subjects" class="btn btn-primary pe-btn-glow pe-hero-btn">
              <i class="ri-compass-3-line me-1.5"></i> <span>Explore Subjects</span>
            </a>
            <a href="/live-sessions" class="btn btn-outline-light pe-hero-btn">
              <i class="ri-calendar-event-line me-1.5"></i> <span>Join Live Sessions</span>
            </a>
          </div>

          <!-- Search bar (Fixed & Unaltered) -->
          <form action="/courses" method="GET" class="pe-promo-search">
            <i class="ri-search-line me-2 text-primary search-icon" style="font-size: 1.15rem;"></i>
            <input type="text" name="search" placeholder="Search Seminars, Workshops, Anatomy, Neuro...">
            <button type="submit">
              <span>Search</span> <i class="ri-arrow-right-line ms-1"></i>
            </button>
          </form>
        </div>
      </div>

      <!-- Right Column: Visual Image Showcase -->
      <div class="col-lg-6 position-relative">
        <div class="pe-hero-visual-wrapper">
          <!-- Main Hero Image with Frame -->
          <div class="pe-hero-img-container">
            <img src="<%= (typeof heroSettings !== 'undefined' && heroSettings.imageUrl) ? heroSettings.imageUrl : '/images/hero_physio_education.jpg' %>" alt="Physiotherapy Education & Clinical Workshop" class="pe-hero-main-img img-fluid" onerror="this.onerror=null; this.src='/images/hero_physio_education.jpg';">
            <div class="pe-hero-img-overlay"></div>
          </div>
        </div>
      </div>
    </div>

    <!-- Dynamic Hero Feature Cards Strip (Smart Auto-Color & Related Icon Resolver) -->
    <% if (typeof heroFeatures !== 'undefined' && heroFeatures.length > 0) { 
         const COLOR_PALETTE = ['warning', 'info', 'purple', 'success', 'danger', 'primary', 'indigo', 'teal', 'orange'];
         function resolveSmartIcon(title, fallbackIcon) {
           if (!title) return fallbackIcon || 'ri-star-line';
           const t = title.toLowerCase();
           if (t.includes('student') || t.includes('learner') || t.includes('enroll')) return 'ri-graduation-cap-line';
           if (t.includes('seminar') || t.includes('webinar')) return 'ri-slideshow-3-line';
           if (t.includes('record') || t.includes('video') || t.includes('lecture')) return 'ri-video-download-line';
           if (t.includes('workshop') || t.includes('practical')) return 'ri-tools-line';
           if (t.includes('live') || t.includes('class')) return 'ri-live-line';
           if (t.includes('free') || t.includes('course') || t.includes('module')) return 'ri-gift-line';
           if (t.includes('note') || t.includes('study') || t.includes('pdf')) return 'ri-file-text-line';
           return fallbackIcon || 'ri-star-line';
         }
    %>
      <div class="pe-hero-features-grid mt-4 pt-2">
        <div class="row g-3">
          <% heroFeatures.forEach((feat, idx) => { 
               const assignedColor = (feat.badge_color && feat.badge_color !== 'warning') ? feat.badge_color : COLOR_PALETTE[idx % COLOR_PALETTE.length];
               const assignedIcon = resolveSmartIcon(feat.title, feat.icon);
          %>
            <div class="col-6 col-md">
              <a href="<%= feat.url || '/courses' %>" class="pe-feature-card">
                <div class="pe-feature-icon bg-<%= assignedColor %>-subtle text-<%= assignedColor %>">
                  <i class="<%= assignedIcon %>"></i>
                </div>
                <div>
                  <div class="pe-feature-title"><%= feat.title %></div>
                  <div class="pe-feature-desc font-weight-bold text-dark"><%= feat.subtitle %></div>
                </div>
              </a>
            </div>
          <% }) %>
        </div>
      </div>
    <% } %>
  </div>
</section>


<!-- ============ PRESENT COURSES SLIDER TICKER ============ -->
<% if (typeof heroSettings === 'undefined' || heroSettings.tickerEnabled !== false) { %>
<section class="pe-therapy-slider-section">
  <div class="container-fluid px-0">
    <div class="pe-therapy-slider">
      <div class="pe-therapy-track" style="animation-duration: <%= (typeof heroSettings !== 'undefined' && heroSettings.tickerSpeed) ? heroSettings.tickerSpeed : 110 %>s;">
        <% 
          let tickerSubjects = [];
          [1,2,3,4].forEach(y => {
            if (typeof categoriesByYear !== 'undefined' && categoriesByYear[y]) {
              tickerSubjects = tickerSubjects.concat(categoriesByYear[y]);
            }
          });
          if (tickerSubjects.length === 0 && typeof activeCourses !== 'undefined') {
            tickerSubjects = activeCourses;
          }
          const marqueeList = tickerSubjects.concat(tickerSubjects).concat(tickerSubjects); 
        %>
        <% marqueeList.forEach(sub => { %>
          <a href="/subjects/<%= sub.slug %>" class="pe-therapy-pill" title="View <%= sub.name %>">
            <i class="ri-book-read-line me-1.5 text-warning"></i>
            <span><%= sub.name %></span>
            <% if (typeof SUBJECT_ABBREVIATIONS !== 'undefined' && SUBJECT_ABBREVIATIONS[sub.name]) { %>
              <span class="badge bg-white text-primary ms-1.5 rounded-pill" style="font-size: 0.72rem; padding: 0.25rem 0.55rem; font-weight: 700;"><%= SUBJECT_ABBREVIATIONS[sub.name] %></span>
            <% } else if (sub.year) { %>
              <span class="badge bg-white text-primary ms-1.5 rounded-pill" style="font-size: 0.72rem; padding: 0.25rem 0.55rem; font-weight: 700;">Year <%= sub.year %></span>
            <% } %>
          </a>
        <% }) %>
      </div>
    </div>
  </div>
</section>
<% } %>

<!-- ================================================================= -->
<!-- DYNAMIC REORDERABLE HOMEPAGE SECTIONS (Admin Position Order)      -->
<!-- ================================================================= -->
<% 
  const activeSectionsList = (typeof homepageSections !== 'undefined' && homepageSections && homepageSections.length > 0)
    ? homepageSections
    : [
        { section_key: 'learning_journey' },
        { section_key: 'curriculum' },
        { section_key: 'featured_subjects' },
        { section_key: 'faculty_trust' },
        { section_key: 'vision_mission' },
        { section_key: 'founders' },
        { section_key: 'callback_appointment' },
        { section_key: 'cta' }
      ];
%>

<% activeSectionsList.forEach(secItem => { %>

  <!-- 1. LEARNING JOURNEY 5-PILLAR SECTION -->
  <% if (secItem.section_key === 'learning_journey') { %>
    <% if (typeof journeySettings === 'undefined' || journeySettings.isEnabled !== false) { 
         const activeJourneyCards = (typeof journeyCards !== 'undefined' && journeyCards && journeyCards.length > 0) ? journeyCards : [
           { title: 'MCQs', subtitle: 'Practice subject-wise MCQs with instant results', icon: 'ri-file-text-line', url: '/learning-modules?type=mcq', badge_color: 'primary' },
           { title: 'LAQs & SAQs', subtitle: 'Prepare with structured long and short answers', icon: 'ri-edit-2-line', url: '/learning-modules?type=large-qa', badge_color: 'info' },
           { title: 'Live Discussion', subtitle: 'Discuss clinical cases with peers and mentors', icon: 'ri-group-line', url: '/live-discussion', badge_color: 'success' },
           { title: 'Live Classes', subtitle: 'Join interactive learning sessions', icon: 'ri-play-circle-fill', url: '/live-sessions', badge_color: 'danger' },
           { title: 'Reference Books', subtitle: 'Explore recommended textbooks and resources', icon: 'ri-book-2-line', url: '/subjects', badge_color: 'warning' }
         ];
    %>
    <section class="pe-section pe-learning-journey-section py-5 position-relative" id="journey-section">
      <div class="container py-2">
        <div class="text-center mb-5">
          <span class="badge bg-primary-subtle text-primary fw-bold text-uppercase px-3.5 py-2 rounded-pill mb-3 shadow-xs" style="font-size: 0.78rem; letter-spacing: 0.05em;">
            <i class="<%= (typeof journeySettings !== 'undefined' && journeySettings.badgeIcon) || 'ri-compass-3-line' %> me-1.5 fs-6 align-middle"></i> <%= (typeof journeySettings !== 'undefined' && journeySettings.badgeText) || 'Academic Pathways & Resources' %>
          </span>
          <h2 class="pe-section-title font-weight-bold display-6 mb-3 text-dark" style="letter-spacing: -0.02em;"><%= (typeof journeySettings !== 'undefined' && journeySettings.title) || 'Your Learning Journey' %></h2>
          <p class="pe-section-sub mx-auto text-secondary leading-relaxed" style="max-width: 680px; font-size: 1.05rem;">
            <%= (typeof journeySettings !== 'undefined' && journeySettings.subtext) || 'Access everything you need for academic learning, examination preparation and clinical application.' %>
          </p>
        </div>

        <div class="pe-journey-grid">
          <% activeJourneyCards.forEach(card => { 
               const themeClass = 'pe-journey-' + (card.badge_color || 'primary');
          %>
            <a href="<%= card.url || '#' %>" class="pe-journey-card <%= themeClass %>">
              <div class="pe-journey-icon">
                <i class="<%= card.icon || 'ri-file-text-line' %>"></i>
              </div>
              <h3 class="pe-journey-title"><%= card.title %></h3>
              <p class="pe-journey-desc"><%= card.subtitle || '' %></p>
              <div class="pe-journey-arrow">
                <i class="ri-arrow-right-line"></i>
              </div>
            </a>
          <% }) %>
        </div>
      </div>
    </section>
    <% } %>

  <!-- 2. ACADEMIC CURRICULUM BY YEAR -->
  <% } else if (secItem.section_key === 'curriculum') { %>
    <% if (typeof curriculumSettings === 'undefined' || curriculumSettings.isEnabled !== false) { %>
    <section class="pe-section bg-white py-5 position-relative" id="subjects-section">
      <div class="container py-2">
        <div class="text-center mb-5">
          <span class="badge bg-primary-subtle text-primary fw-bold text-uppercase px-3.5 py-2 rounded-pill mb-3 shadow-xs" style="font-size: 0.78rem; letter-spacing: 0.05em;">
            <i class="<%= (typeof curriculumSettings !== 'undefined' && curriculumSettings.badgeIcon) || 'ri-graduation-cap-line' %> me-1.5 fs-6 align-middle"></i> <%= (typeof curriculumSettings !== 'undefined' && curriculumSettings.badgeText) || 'Academic Curriculum & Syllabus' %>
          </span>
          <h2 class="pe-section-title font-weight-bold display-6 mb-3 text-dark" style="letter-spacing: -0.02em;"><%= (typeof curriculumSettings !== 'undefined' && curriculumSettings.title) || 'Comprehensive Physiotherapy Curriculum by Year' %></h2>
          <p class="pe-section-sub mx-auto text-secondary leading-relaxed" style="max-width: 740px; font-size: 1.05rem;">
            <%= (typeof curriculumSettings !== 'undefined' && curriculumSettings.subtext) || 'Master foundational medical sciences, clinical assessments, rehabilitation specialties, and allied disciplines — structured systematically as per the Indian Physiotherapy University curriculum.' %>
          </p>
        </div>

        <!-- 5 Clickable Executive Year Cards Navigation -->
        <div class="pe-year-cards-row mb-5" role="tablist" id="yearCardsNav">
          <% 
            const cCards = (typeof curriculumCards !== 'undefined' && curriculumCards && curriculumCards.length > 0) ? curriculumCards : [
              { year_key: '1', tag: 'Year 1 • Foundation', title: 'First Year', subtitle: 'Core Anatomy, Physiology, Biomechanics & basic principles', icon: 'ri-book-3-fill', theme_color: 'primary' },
              { year_key: '2', tag: 'Year 2 • Clinical Core', title: 'Second Year', subtitle: 'Pathology, Pharmacology, Exercise Therapy & Electrotherapy', icon: 'ri-microscope-line', theme_color: 'success' },
              { year_key: '3', tag: 'Year 3 • Advanced Practice', title: 'Third Year', subtitle: 'General Medicine, Surgery, Orthopedics & Clinical Diagnosis', icon: 'ri-heart-pulse-fill', theme_color: 'danger' },
              { year_key: '4', tag: 'Year 4 • Specialties & Rehab', title: 'Fourth Year', subtitle: 'Neurology, Cardiothoracic, Sports PT & Community Rehabilitation', icon: 'ri-stethoscope-fill', theme_color: 'warning' },
              { year_key: 'other', tag: 'Allied • Interdisciplinary', title: 'Other Subjects', subtitle: 'Allied health, research methodology & clinical skill modules', icon: 'ri-apps-2-fill', theme_color: 'purple' }
            ];
            const activeTargetId = cCards[0].year_key === 'other' ? 'yearOther' : ('year' + cCards[0].year_key);
          %>
          <% cCards.forEach((c, idx) => { 
               const targetId = c.year_key === 'other' ? 'yearOther' : ('year' + c.year_key);
               const colorClass = c.theme_color ? `pe-year-card-${c.theme_color}` : (c.year_key === 'other' ? 'pe-year-card-other' : `pe-year-card-${c.year_key}`);
          %>
            <button type="button" class="pe-year-card-btn <%= colorClass %> <%= idx===0 ? 'active' : '' %>" id="btn-<%= targetId %>" data-bs-toggle="pill" data-bs-target="#<%= targetId %>" role="tab" aria-controls="<%= targetId %>" aria-selected="<%= idx===0 ? 'true' : 'false' %>">
              <% if (c.tag) { %>
                <span class="pe-year-card-tag"><%= c.tag %></span>
              <% } %>
              <div class="pe-year-card-icon">
                <i class="<%= c.icon || 'ri-book-3-fill' %>"></i>
              </div>
              <h4 class="pe-year-card-title"><%= c.title %></h4>
              <% if (c.subtitle) { %>
                <p class="pe-year-card-sub"><%= c.subtitle %></p>
              <% } %>
              <div class="pe-year-card-footer mt-auto pt-2 text-center">
                <span class="pe-year-card-arrow">
                  <i class="ri-arrow-right-line"></i>
                </span>
              </div>
            </button>
          <% }) %>
        </div>

        <!-- Tab Content Panels -->
        <div class="tab-content" id="yearCardsContent">
          <% 
            const yearMeta = {
              1: { label: 'First Year BPT', subtitle: 'Foundational medical sciences, anatomy osteology, physiology, and basic physiotherapy modalities', color: 'primary', bgGradient: 'linear-gradient(135deg, rgba(10, 93, 194, 0.08) 0%, rgba(2, 132, 199, 0.04) 100%)', borderColor: '#d0e3fa', icon: 'ri-book-3-fill' },
              2: { label: 'Second Year BPT', subtitle: 'Clinical pathology, pharmacology principles, exercise therapy techniques, and electrophysical agents', color: 'success', bgGradient: 'linear-gradient(135deg, rgba(22, 163, 74, 0.08) 0%, rgba(34, 197, 94, 0.04) 100%)', borderColor: '#bbf7d0', icon: 'ri-microscope-line' },
              3: { label: 'Third Year BPT', subtitle: 'General medicine, surgical rehabilitation, adult & pediatric orthopedics, and clinical diagnosis', color: 'danger', bgGradient: 'linear-gradient(135deg, rgba(225, 29, 72, 0.08) 0%, rgba(244, 63, 94, 0.04) 100%)', borderColor: '#fecdd3', icon: 'ri-heart-pulse-fill' },
              4: { label: 'Fourth Year BPT', subtitle: 'Neurological rehabilitation, cardiothoracic management, sports physiotherapy, and community health', color: 'warning', bgGradient: 'linear-gradient(135deg, rgba(217, 119, 6, 0.08) 0%, rgba(245, 158, 11, 0.04) 100%)', borderColor: '#fde68a', icon: 'ri-stethoscope-fill' }
            };
          %>
          <% [1,2,3,4].forEach((y) => { %>
            <div class="tab-pane fade <%= activeTargetId===('year'+y)?'show active':'' %>" id="year<%= y %>" role="tabpanel" aria-labelledby="btn-year<%= y %>">
              <div class="pe-year-banner-header d-flex align-items-center justify-content-between mb-4 flex-wrap gap-3" style="background: <%= yearMeta[y].bgGradient %>; border: 1.5px solid <%= yearMeta[y].borderColor %>;">
                <div class="d-flex align-items-center gap-3">
                  <div class="p-2.5 rounded-4 bg-white text-<%= yearMeta[y].color %> shadow-sm fs-4 d-flex align-items-center justify-content-center flex-shrink-0" style="width:50px; height:50px;">
                    <i class="<%= yearMeta[y].icon %>"></i>
                  </div>
                  <div>
                    <h5 class="fw-bold text-dark mb-0.5"><%= yearMeta[y].label %> Curriculum</h5>
                    <p class="text-secondary small mb-0"><%= yearMeta[y].subtitle %></p>
                  </div>
                </div>
                <div class="d-flex align-items-center gap-2">
                  <span class="badge bg-white text-<%= yearMeta[y].color %> border shadow-xs rounded-pill px-3 py-2 fw-bold font-monospace small">
                    <%= (categoriesByYear[y] || []).length %> Core Subjects
                  </span>
                  <a href="/subjects?year=<%= y %>" class="btn btn-sm btn-white bg-white border shadow-xs text-dark rounded-pill px-3.5 py-1.5 fw-semibold" style="transition: all 0.2s ease;">
                    Explore Syllabus <i class="ri-arrow-right-s-line"></i>
                  </a>
                </div>
              </div>

              <div class="row g-3 g-md-4">
                <% (categoriesByYear[y] || []).forEach(cat => { %>
                  <div class="col-6 col-md-4 col-lg-3">
                    <a href="/subjects/<%= cat.slug %>" class="pe-subject-box text-decoration-none d-block h-100">
                      <div class="pe-subject-box-inner p-3.5 p-md-4 rounded-4 bg-white border h-100 position-relative shadow-xs">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                          <div class="pe-subject-icon bg-<%= yearMeta[y].color %>-subtle text-<%= yearMeta[y].color %> fs-3">
                            <i class="<%= cat.icon || 'ri-book-open-line' %>"></i>
                          </div>
                          <% if (typeof SUBJECT_ABBREVIATIONS !== 'undefined' && SUBJECT_ABBREVIATIONS[cat.name]) { %>
                            <span class="badge bg-light text-<%= yearMeta[y].color %> border rounded-pill px-2.5 py-1 small fw-bold font-monospace">
                              <%= SUBJECT_ABBREVIATIONS[cat.name] %>
                            </span>
                          <% } else { %>
                            <span class="pe-subject-arrow-btn">
                              <i class="ri-arrow-right-line"></i>
                            </span>
                          <% } %>
                        </div>
                        <h6 class="pe-subject-title mb-1.5"><%= cat.name %></h6>
                        <div class="d-flex align-items-center justify-content-between text-muted small mt-auto pt-2 border-top">
                          <span class="d-inline-flex align-items-center text-muted" style="font-size: 0.8rem;">
                            <i class="ri-checkbox-circle-fill text-success me-1"></i>
                            <%= cat.course_count || 0 %> module<%= cat.course_count !== 1 ? 's' : '' %>
                          </span>
                          <span class="text-primary fw-bold small d-none d-sm-inline-flex align-items-center gap-0.5" style="font-size: 0.8rem;">
                            Explore <i class="ri-arrow-right-s-line"></i>
                          </span>
                        </div>
                      </div>
                    </a>
                  </div>
                <% }) %>
              </div>
            </div>
          <% }) %>

          <!-- Other Subjects Panel -->
          <div class="tab-pane fade <%= activeTargetId==='yearOther'?'show active':'' %>" id="yearOther" role="tabpanel" aria-labelledby="btn-yearOther">
            <div class="pe-year-banner-header d-flex align-items-center justify-content-between mb-4 flex-wrap gap-3" style="background: linear-gradient(135deg, rgba(124, 58, 237, 0.08) 0%, rgba(139, 92, 246, 0.04) 100%); border: 1.5px solid #ddd6fe;">
              <div class="d-flex align-items-center gap-3">
                <div class="p-2.5 rounded-4 bg-white text-purple shadow-sm fs-4 d-flex align-items-center justify-content-center flex-shrink-0" style="width:50px; height:50px;">
                  <i class="ri-apps-2-fill"></i>
                </div>
                <div>
                  <h5 class="fw-bold text-dark mb-0.5">Other Subjects & Allied Disciplines</h5>
                  <p class="text-secondary small mb-0">Interdisciplinary clinical topics, research methodologies, and electives</p>
                </div>
              </div>
              <div class="d-flex align-items-center gap-2">
                <span class="badge bg-white text-purple border shadow-xs rounded-pill px-3 py-2 fw-bold font-monospace small">
                  <%= otherSubjects.length %> Elective Subjects
                </span>
                <a href="/subjects" class="btn btn-sm btn-white bg-white border shadow-xs text-dark rounded-pill px-3.5 py-1.5 fw-semibold" style="transition: all 0.2s ease;">
                  View All <i class="ri-arrow-right-s-line"></i>
                </a>
              </div>
            </div>

            <div class="row g-3 g-md-4">
              <% if (!otherSubjects || otherSubjects.length === 0) { %>
                <div class="col-12 text-center py-5 text-muted">
                  <i class="ri-folder-open-line fs-1 d-block mb-2 text-muted"></i>
                  No additional elective subjects found. Check back soon!
                </div>
              <% } %>
              <% otherSubjects.forEach(cat => { %>
                <div class="col-6 col-md-4 col-lg-3">
                  <a href="/subjects/<%= cat.slug %>" class="pe-subject-box text-decoration-none d-block h-100">
                    <div class="pe-subject-box-inner p-3.5 p-md-4 rounded-4 bg-white border h-100 position-relative shadow-xs">
                      <div class="d-flex justify-content-between align-items-start mb-3">
                        <div class="pe-subject-icon bg-purple-subtle text-purple fs-3">
                          <i class="<%= cat.icon || 'ri-book-open-line' %>"></i>
                        </div>
                        <% if (typeof SUBJECT_ABBREVIATIONS !== 'undefined' && SUBJECT_ABBREVIATIONS[cat.name]) { %>
                          <span class="badge bg-light text-purple border rounded-pill px-2.5 py-1 small fw-bold font-monospace">
                            <%= SUBJECT_ABBREVIATIONS[cat.name] %>
                          </span>
                        <% } else { %>
                          <span class="pe-subject-arrow-btn">
                            <i class="ri-arrow-right-line"></i>
                          </span>
                        <% } %>
                      </div>
                      <h6 class="pe-subject-title mb-1.5"><%= cat.name %></h6>
                      <div class="d-flex align-items-center justify-content-between text-muted small mt-auto pt-2 border-top">
                        <span class="d-inline-flex align-items-center text-muted" style="font-size: 0.8rem;">
                          <i class="ri-checkbox-circle-fill text-success me-1"></i>
                          <%= cat.course_count || 0 %> module<%= cat.course_count !== 1 ? 's' : '' %>
                        </span>
                        <span class="text-primary fw-bold small d-none d-sm-inline-flex align-items-center gap-0.5" style="font-size: 0.8rem;">
                          Explore <i class="ri-arrow-right-s-line"></i>
                        </span>
                      </div>
                    </div>
                  </a>
                </div>
              <% }) %>
            </div>
          </div>
        </div>
      </div>
    </section>
    <% } %>

  <!-- 3. FEATURED SUBJECTS & COURSES -->
  <% } else if (secItem.section_key === 'featured_subjects') { %>
    <section class="pe-section bg-white">
      <div class="container">
        <div class="d-flex align-items-end justify-content-between mb-4 flex-wrap gap-3">
          <div>
            <span class="pe-eyebrow">Top Rated</span>
            <h2 class="pe-section-title mb-0">Featured Subjects</h2>
          </div>
          <div class="d-flex align-items-center gap-2 flex-wrap">
            <button type="button" class="btn btn-primary btn-sm rounded-pill px-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#featuredCoursesModal">
              <i class="ri-star-fill text-warning me-1"></i> Display All Featured Subjects
            </button>
