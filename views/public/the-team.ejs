<!-- Hero Header -->
<section class="pe-team-hero text-center py-5 text-white" style="background: linear-gradient(135deg, #0a5dc2 0%, #0369a1 100%);">
  <div class="container py-4 text-center">
    <span class="badge bg-warning text-dark font-weight-bold text-uppercase px-3 py-1.5 rounded-pill mb-3" style="font-size: 0.8rem;">
      <i class="ri-team-line me-1"></i> Our People & Faculty
    </span>
    <h1 class="text-white fw-bold display-5 mb-3">The Team Behind PhysioEdvance</h1>
    <p class="text-white-75 mx-auto lead" style="max-width:680px; font-size: 1.1rem;">
      Built by experienced educators, subject matter experts, technical advisors, and administrative staff united by one mission —
      <br><em class="fw-bold text-warning">"Help students to help themselves."</em>
    </p>
  </div>
</section>

<!-- ============ 1. THE FACE ============ -->
<% if (typeof theFace !== 'undefined' && theFace.length > 0) { %>
<section id="the-face" class="pe-section bg-white py-5 border-bottom">
  <div class="container">
    <div class="pe-section-head text-center mb-5">
      <span class="badge bg-primary text-white font-weight-bold px-3 py-1.5 rounded-pill mb-2" style="font-size: 0.8rem;">
        <i class="ri-star-fill me-1 text-warning"></i> Leadership & Visionaries
      </span>
      <h2 class="fw-bold text-dark display-6">The Face</h2>
      <p class="text-muted" style="max-width: 600px; margin: 0 auto;">The visionary founders and leaders driving PhysioEdvance.</p>
    </div>

    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 justify-content-center">
      <% theFace.forEach(m => { %>
        <div class="col">
          <div class="card h-100 border-0 shadow-sm rounded-4 text-center p-4 bg-white transition-all pe-pro-card border">
            <div class="position-relative d-inline-block mx-auto mb-3">
              <img src="<%= m.photo || '/images/team/default-avatar.png' %>" alt="<%= m.name %>" class="rounded-circle border border-4 border-warning shadow-sm" style="width: 115px; height: 115px; object-fit: cover;" onerror="this.src='https://ui-avatars.com/api/?name=<%= encodeURIComponent(m.name) %>&background=0a5dc2&color=fff&size=256'">
              <span class="position-absolute bottom-0 end-0 bg-warning text-dark rounded-circle d-flex align-items-center justify-content-center border border-2 border-white shadow-sm" style="width: 28px; height: 28px; font-size: 0.8rem;" title="Founder / Leader">
                <i class="ri-star-fill"></i>
              </span>
            </div>
            <h5 class="fw-bold text-dark mb-1"><%= m.name %></h5>
            <div class="text-primary font-weight-bold small mb-1"><%= m.designation || m.role || 'Leadership' %></div>
            <% if (m.qualification) { %>
              <div class="text-muted small mb-2"><i class="ri-graduation-cap-line me-1"></i><%= m.qualification %></div>
            <% } %>
            <% if (m.bio) { %>
              <p class="text-secondary small mb-0 mt-2" style="font-size: 0.85rem; white-space: pre-line;"><%= m.bio %></p>
            <% } %>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<!-- ============ 2. CORE MEMBERS ============ -->
<% if (typeof coreMembers !== 'undefined' && coreMembers.length > 0) { %>
<section id="core-members" class="pe-section bg-light py-5 border-bottom">
  <div class="container">
    <div class="pe-section-head text-center mb-5">
      <span class="badge bg-primary-subtle text-primary font-weight-bold px-3 py-1.5 rounded-pill mb-2" style="font-size: 0.8rem;">
        <i class="ri-book-open-line me-1"></i> Academic Faculty & Core Team
      </span>
      <h2 class="fw-bold text-dark display-6">Core Members</h2>
      <p class="text-muted" style="max-width: 600px; margin: 0 auto;">Professors, clinical instructors, and core operational staff guiding student success.</p>
    </div>

    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 row-cols-xl-4 g-4 justify-content-center">
      <% coreMembers.forEach(m => { %>
        <div class="col">
          <div class="card h-100 border-0 shadow-sm rounded-4 text-center p-4 bg-white transition-all pe-pro-card border">
            <div class="position-relative d-inline-block mx-auto mb-3">
              <img src="<%= m.photo || '/images/team/default-avatar.png' %>" alt="<%= m.name %>" class="rounded-circle border border-3 border-primary shadow-sm" style="width: 105px; height: 105px; object-fit: cover;" onerror="this.src='https://ui-avatars.com/api/?name=<%= encodeURIComponent(m.name) %>&background=0a5dc2&color=fff&size=256'">
              <span class="position-absolute bottom-0 end-0 bg-primary text-white rounded-circle d-flex align-items-center justify-content-center border border-2 border-white shadow-sm" style="width: 26px; height: 26px; font-size: 0.78rem;" title="Core Member">
                <i class="ri-user-heart-fill"></i>
              </span>
            </div>
            <h5 class="fw-bold text-dark mb-1"><%= m.name %></h5>
            <div class="text-primary font-weight-semibold small mb-1"><%= m.designation || 'Core Faculty' %></div>
            <% if (m.qualification) { %>
              <div class="text-muted small mb-2"><i class="ri-award-line text-warning me-1"></i><%= m.qualification %></div>
            <% } %>
            <% if (m.bio) { %>
              <p class="text-secondary small mb-0 mt-2 line-clamp-2" style="font-size: 0.85rem; white-space: pre-line;"><%= m.bio %></p>
            <% } %>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<!-- ============ 3. EXPERT ADVISORS ============ -->
<% if (typeof expertAdvisors !== 'undefined' && expertAdvisors.length > 0) { %>
<section id="expert-advisors" class="pe-section bg-white py-5 border-bottom">
  <div class="container">
    <div class="pe-section-head text-center mb-5">
      <span class="badge bg-info-subtle text-info font-weight-bold px-3 py-1.5 rounded-pill mb-2" style="font-size: 0.8rem;">
        <i class="ri-award-line me-1"></i> Advisory Board & Subject Specialists
      </span>
      <h2 class="fw-bold text-dark display-6">Expert Advisors</h2>
      <p class="text-muted" style="max-width: 600px; margin: 0 auto;">Clinical experts, subject matter specialists, and strategic advisory board members.</p>
    </div>

    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 row-cols-xl-4 g-4 justify-content-center">
      <% expertAdvisors.forEach(m => { %>
        <div class="col">
          <div class="card h-100 border-0 shadow-sm rounded-4 text-center p-4 bg-white transition-all pe-pro-card border">
            <div class="position-relative d-inline-block mx-auto mb-3">
              <img src="<%= m.photo || '/images/team/default-avatar.png' %>" alt="<%= m.name %>" class="rounded-circle border border-3 border-info shadow-sm" style="width: 100px; height: 100px; object-fit: cover;" onerror="this.src='https://ui-avatars.com/api/?name=<%= encodeURIComponent(m.name) %>&background=0ea5e9&color=fff&size=256'">
              <span class="position-absolute bottom-0 end-0 bg-info text-white rounded-circle d-flex align-items-center justify-content-center border border-2 border-white shadow-sm" style="width: 26px; height: 26px; font-size: 0.75rem;">
                <i class="ri-shield-star-fill"></i>
              </span>
            </div>
            <h5 class="fw-bold text-dark mb-1"><%= m.name %></h5>
            <div class="text-info font-weight-semibold small mb-1"><%= m.designation || 'Specialist Advisor' %></div>
            <% if (m.qualification) { %>
              <div class="text-muted small mb-2"><%= m.qualification %></div>
            <% } %>
            <% if (m.bio) { %>
              <p class="text-secondary small mb-0 mt-2 line-clamp-2" style="font-size: 0.85rem; white-space: pre-line;"><%= m.bio %></p>
            <% } %>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<!-- CTA -->
<section class="pe-cta-section py-5 text-center" style="background: linear-gradient(135deg, #0a5dc2 0%, #0369a1 100%);">
  <div class="container py-3">
    <h2 class="pe-cta-title text-white font-weight-bold mb-2">Join the PhysioEdvance Community</h2>
    <p class="pe-cta-sub text-white-75 mb-4">Start learning from India's best physiotherapy educators — free, forever.</p>
    <div class="d-flex gap-3 justify-content-center flex-wrap">
      <a href="/auth/register" class="btn btn-warning btn-lg rounded-pill px-4 py-2.5 font-weight-bold text-dark shadow-sm">
        <i class="ri-user-add-line me-1"></i> Create Free Account
      </a>
      <a href="/subjects" class="btn btn-outline-light btn-lg rounded-pill px-4 py-2.5 font-weight-bold">
        Explore Subjects <i class="ri-arrow-right-line ms-1"></i>
      </a>
    </div>
  </div>
</section>
