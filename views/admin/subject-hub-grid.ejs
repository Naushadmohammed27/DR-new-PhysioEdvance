<style>
  .pe-grid-diagram {
    background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
    border-radius: 20px;
    padding: 1.75rem;
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }
  .pe-pos-box {
    border: 2px dashed rgba(255, 255, 255, 0.25);
    border-radius: 14px;
    padding: 1.1rem;
    text-align: center;
    background: rgba(255, 255, 255, 0.05);
    transition: all 0.25s ease;
    cursor: pointer;
  }
  .pe-pos-box:hover {
    border-color: #38bdf8;
    background: rgba(56, 189, 248, 0.15);
    transform: translateY(-2px);
  }
  .pe-pos-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: #f59e0b;
    color: #000000;
    font-weight: 800;
    font-size: 0.95rem;
    box-shadow: 0 2px 6px rgba(0,0,0,0.3);
  }
  .pe-card-highlight {
    animation: pePulseHighlight 2s ease-out;
  }
  @keyframes pePulseHighlight {
    0% { transform: scale(1.02); box-shadow: 0 0 0 4px rgba(10, 93, 194, 0.4); }
    100% { transform: scale(1); box-shadow: none; }
  }
</style>

<div class="container-fluid py-4">
  <!-- Header -->
  <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-3">
    <div>
      <span class="badge bg-primary-subtle text-primary font-weight-bold text-uppercase px-3 py-1.5 rounded-pill mb-1">
        <i class="ri-layout-grid-line me-1"></i> Interactive Portal 1-9 Grid CMS
      </span>
      <h2 class="fw-bold mb-0 text-dark">Subject Portal Grid Positions (1 to 9)</h2>
      <p class="text-muted small mb-0">Select any position number (1 to 9) for a module to move it to that grid location. Occupants automatically swap positions.</p>
    </div>
    <div class="d-flex align-items-center gap-2">
      <a href="/subjects/physiology" target="_blank" class="btn btn-outline-primary rounded-pill px-3.5 py-2 fw-semibold">
        <i class="ri-external-link-line me-1"></i> Live View /subjects/physiology
      </a>
    </div>
  </div>

  <% if (typeof success !== 'undefined' && success && success.length > 0) { %>
    <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm border-0 mb-4" role="alert">
      <i class="ri-checkbox-circle-fill me-2 fs-5 align-middle"></i> <%= success %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>

  <%
    const blockMap = {};
    (blocks || []).forEach(b => {
      const pos = Number(b.display_position || b.display_order || 1);
      blockMap[pos] = b;
    });

    const slotNames = {
      1: 'Position 1 — Left Column (Top)',
      2: 'Position 2 — Left Column (Middle)',
      3: 'Position 3 — Left Column (Bottom)',
      4: 'Position 4 — Bottom Row (Left)',
      5: 'Position 5 — Bottom Row (Right)',
      6: 'Position 6 — Right Column (Bottom)',
      7: 'Position 7 — Right Column (Middle)',
      8: 'Position 8 — Right Column (Top)',
      9: 'Position 9 — Center (Main Video & 3D Player)'
    };
  %>

  <!-- VISUAL 1-9 POSITION DIAGRAM MAP -->
  <div class="pe-grid-diagram mb-4 shadow-lg">
    <div class="d-flex align-items-center justify-content-between mb-3 border-bottom border-secondary border-opacity-50 pb-2">
      <h5 class="fw-bold text-white mb-0"><i class="ri-map-pin-2-line text-warning me-2"></i> Visual 1-9 Grid Layout Reference</h5>
      <span class="badge bg-warning text-dark font-weight-bold">Click any box to jump to its edit card</span>
    </div>

    <div class="row g-3 text-white">
      <!-- Left Column (Positions 1, 2, 3) -->
      <div class="col-lg-3 d-flex flex-column gap-2">
        <div class="pe-pos-box" onclick="scrollToModuleCard(<%= blockMap[1] ? blockMap[1].id : '' %>)">
          <span class="pe-pos-num mb-1">1</span>
          <div class="fw-bold text-truncate"><%= blockMap[1] ? blockMap[1].title : 'Region Maps' %></div>
          <small class="text-white-50">Position 1 &bull; Left Top</small>
        </div>
        <div class="pe-pos-box" onclick="scrollToModuleCard(<%= blockMap[2] ? blockMap[2].id : '' %>)">
          <span class="pe-pos-num mb-1">2</span>
          <div class="fw-bold text-truncate"><%= blockMap[2] ? blockMap[2].title : 'Cross Sections' %></div>
          <small class="text-white-50">Position 2 &bull; Left Middle</small>
        </div>
        <div class="pe-pos-box" onclick="scrollToModuleCard(<%= blockMap[3] ? blockMap[3].id : '' %>)">
          <span class="pe-pos-num mb-1">3</span>
          <div class="fw-bold text-truncate"><%= blockMap[3] ? blockMap[3].title : 'Rotatable Physio Slab' %></div>
          <small class="text-white-50">Position 3 &bull; Left Bottom</small>
        </div>
      </div>

      <!-- Center Player (Position 9) -->
      <div class="col-lg-6">
        <div class="pe-pos-box h-100 d-flex flex-column align-items-center justify-content-center bg-primary bg-opacity-20 border-primary" style="min-height: 220px;" onclick="scrollToModuleCard(<%= blockMap[9] ? blockMap[9].id : '' %>)">
          <span class="pe-pos-num mb-2" style="background:#38bdf8; color:#000;">9</span>
          <i class="ri-play-circle-fill display-4 text-warning mb-1"></i>
          <div class="fw-bold fs-5 text-white"><%= blockMap[9] ? blockMap[9].title : 'The Center Point' %></div>
          <small class="text-info fw-semibold">Position 9 &bull; Center Video & 3D Player</small>
        </div>
      </div>

      <!-- Right Column (Positions 8, 7, 6) -->
      <div class="col-lg-3 d-flex flex-column gap-2">
        <div class="pe-pos-box" onclick="scrollToModuleCard(<%= blockMap[8] ? blockMap[8].id : '' %>)">
          <span class="pe-pos-num mb-1">8</span>
          <div class="fw-bold text-truncate"><%= blockMap[8] ? blockMap[8].title : 'HD Videos' %></div>
          <small class="text-white-50">Position 8 &bull; Right Top</small>
        </div>
        <div class="pe-pos-box" onclick="scrollToModuleCard(<%= blockMap[7] ? blockMap[7].id : '' %>)">
          <span class="pe-pos-num mb-1">7</span>
          <div class="fw-bold text-truncate"><%= blockMap[7] ? blockMap[7].title : 'Notes & Models' %></div>
          <small class="text-white-50">Position 7 &bull; Right Middle</small>
        </div>
        <div class="pe-pos-box" onclick="scrollToModuleCard(<%= blockMap[6] ? blockMap[6].id : '' %>)">
          <span class="pe-pos-num mb-1">6</span>
          <div class="fw-bold text-truncate"><%= blockMap[6] ? blockMap[6].title : 'MRI' %></div>
          <small class="text-white-50">Position 6 &bull; Right Bottom</small>
        </div>
      </div>

      <!-- Bottom Row (Positions 4 & 5) -->
      <div class="col-md-6">
        <div class="pe-pos-box" onclick="scrollToModuleCard(<%= blockMap[4] ? blockMap[4].id : '' %>)">
          <span class="pe-pos-num mb-1">4</span>
          <div class="fw-bold text-truncate"><%= blockMap[4] ? blockMap[4].title : 'Subject Syllabus' %></div>
          <small class="text-white-50">Position 4 &bull; Bottom Left</small>
        </div>
      </div>
      <div class="col-md-6">
        <div class="pe-pos-box" onclick="scrollToModuleCard(<%= blockMap[5] ? blockMap[5].id : '' %>)">
          <span class="pe-pos-num mb-1">5</span>
          <div class="fw-bold text-truncate"><%= blockMap[5] ? blockMap[5].title : 'Stroke & Pathology' %></div>
          <small class="text-white-50">Position 5 &bull; Bottom Right</small>
        </div>
      </div>
    </div>
  </div>

  <!-- MODULE EDIT CARDS LIST WITH EASY POSITION NUMBER SELECTOR (1 to 9) -->
  <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
    <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2 border-bottom pb-3">
      <div>
        <h4 class="fw-bold text-dark mb-1"><i class="ri-edit-2-line text-primary me-2"></i> Edit Module Titles & Grid Positions</h4>
        <p class="text-muted small mb-0">Changing a module's Position Number moves it directly to that location on the subject page grid.</p>
      </div>
    </div>

    <div class="row g-3">
      <% (blocks || []).sort((a,b) => Number(a.display_position || 1) - Number(b.display_position || 1)).forEach(blk => { 
          const pos = Number(blk.display_position || blk.display_order || 1);
      %>
        <div class="col-md-6 col-lg-4" id="card-module-<%= blk.id %>">
          <div class="card border rounded-4 p-3 bg-light-subtle h-100 transition-all border-1">
            <form action="/admin/subject-hub-grid/<%= blk.id %>/update" method="POST">
              <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom">
                <div class="d-flex align-items-center gap-2">
                  <span class="badge bg-warning text-dark font-weight-bold px-2.5 py-1.5 rounded-pill" style="font-size: 0.88rem;">
                    Position <%= pos %>
                  </span>
                  <span class="badge bg-primary-subtle text-primary font-weight-semibold rounded-pill px-2.5 py-1" style="font-size: 0.78rem;">
                    <i class="<%= blk.icon || 'ri-box-3-line' %> me-1"></i> <%= blk.block_key %>
                  </span>
                </div>
              </div>

              <!-- Position Selector with Dynamic Swap Hints -->
              <div class="mb-3">
                <label class="form-label text-dark small fw-bold mb-1">
                  <i class="ri-map-pin-line text-primary me-1"></i> Grid Slot Location (1 to 9)
                </label>
                <select name="display_position" class="form-select form-select-lg rounded-3 font-weight-bold text-primary border-primary border-opacity-50 shadow-sm" style="font-size:0.95rem;">
                  <% for (let i = 1; i <= 9; i++) { 
                       const occupant = blockMap[i];
                       const isCurrent = (pos === i);
                       let optionText = slotNames[i];
                       if (isCurrent) {
                         optionText += '  ✓ (Current Slot)';
                       } else if (occupant) {
                         optionText += `  ↔ [Swaps with: "${occupant.title}"]`;
                       }
                  %>
                    <option value="<%= i %>" <%= pos === i ? 'selected' : '' %>>
                      <%= optionText %>
                    </option>
                  <% } %>
                </select>
              </div>

              <!-- Module Display Title -->
              <div class="mb-3">
                <label class="form-label text-dark small fw-bold mb-1">
                  <i class="ri-text me-1 text-secondary"></i> Display Title on Grid
                </label>
                <input type="text" name="title" class="form-control form-control-lg rounded-3 font-weight-bold text-dark border-secondary border-opacity-25" value="<%= blk.title %>" required placeholder="Enter module title...">
              </div>

              <!-- Icon Class -->
              <div class="mb-3">
                <label class="form-label text-muted small fw-bold mb-1">
                  <i class="ri-remixicon-line me-1"></i> Icon Class Name (RemixIcon)
                </label>
                <div class="input-group">
                  <span class="input-group-text bg-white"><i class="<%= blk.icon || 'ri-box-3-line' %> text-primary"></i></span>
                  <input type="text" name="icon" class="form-control form-control-sm rounded-end-3" value="<%= blk.icon %>" placeholder="e.g. ri-brain-line">
                </div>
              </div>

              <!-- Active Status & Save Button -->
              <div class="pt-2 border-top d-flex align-items-center justify-content-between mt-auto">
                <div class="form-check form-switch m-0">
                  <input class="form-check-input" type="checkbox" name="is_active" value="1" <%= blk.is_active ? 'checked' : '' %>>
                  <label class="form-check-label small fw-semibold text-muted">Active</label>
                </div>
                <button type="submit" class="btn btn-primary rounded-pill px-4 font-weight-bold shadow-sm">
                  <i class="ri-save-line me-1"></i> Save Position
                </button>
              </div>
            </form>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
</div>

<script>
  function scrollToModuleCard(cardId) {
    if (!cardId) return;
    const cardEl = document.getElementById('card-module-' + cardId);
    if (cardEl) {
      cardEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
      cardEl.classList.add('pe-card-highlight');
      setTimeout(() => cardEl.classList.remove('pe-card-highlight'), 2000);
    }
  }
</script>
