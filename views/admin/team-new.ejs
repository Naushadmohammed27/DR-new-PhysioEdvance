<div class="d-flex align-items-center justify-content-between mb-4">
  <div class="d-flex align-items-center gap-3">
    <a href="/admin/team" class="btn btn-outline-secondary rounded-pill px-3 py-2">
      <i class="ri-arrow-left-line me-1"></i> Back to Team Management
    </a>
    <div>
      <h4 class="mb-0 fw-bold">Add Team Member</h4>
      <span class="text-muted small">Fill in the profile details below to add a new member to The Face, Core Members, or Expert Advisors.</span>
    </div>
  </div>
</div>

<form action="/admin/team" method="POST" enctype="multipart/form-data">
  <div class="row g-4">
    <!-- Left Column: Primary Details -->
    <div class="col-lg-7">
      <div class="card shadow-sm border-0 mb-4" style="border-radius: 16px;">
        <div class="card-header bg-white py-3 border-bottom">
          <h5 class="mb-0 fw-bold text-dark"><i class="ri-user-add-line me-2 text-primary"></i>Member Information</h5>
        </div>
        <div class="card-body p-4">
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label font-weight-bold">Full Name <span class="text-danger">*</span></label>
              <input type="text" name="name" class="form-control form-control-lg" required placeholder="e.g. Dr. Rajesh Sharma">
            </div>

            <div class="col-md-6">
              <label class="form-label font-weight-bold">Designation / Role Title <span class="text-danger">*</span></label>
              <input type="text" name="designation" class="form-control form-control-lg" placeholder="e.g. Faculty, Teacher, Worker, Senior Lecturer" required id="newDesignationInput">
              <div class="mt-2 d-flex flex-wrap gap-1">
                <button type="button" class="btn btn-sm btn-light border py-1 px-2 text-primary fw-semibold" onclick="document.getElementById('newDesignationInput').value='Academic Faculty'">+ Faculty</button>
                <button type="button" class="btn btn-sm btn-light border py-1 px-2 text-primary fw-semibold" onclick="document.getElementById('newDesignationInput').value='Expert Teacher'">+ Teacher</button>
                <button type="button" class="btn btn-sm btn-light border py-1 px-2 text-primary fw-semibold" onclick="document.getElementById('newDesignationInput').value='Operations Worker'">+ Worker / Staff</button>
                <button type="button" class="btn btn-sm btn-light border py-1 px-2 text-primary fw-semibold" onclick="document.getElementById('newDesignationInput').value='Subject Specialist'">+ Specialist</button>
              </div>
            </div>

            <div class="col-md-6">
              <label class="form-label font-weight-bold">Role Title (Optional)</label>
              <input type="text" name="role" class="form-control form-control-lg" placeholder="e.g. Lead Instructor, Senior Faculty">
            </div>

            <div class="col-md-6">
              <label class="form-label font-weight-bold">Staff Group Section <span class="text-danger">*</span></label>
              <select name="group_name" class="form-select form-select-lg" required>
                <option value="the_face">🌟 1. The Face (Founders, Leadership & Visionaries)</option>
                <option value="core_members" selected>🎓 2. Core Members (Academic Faculty & Core Team)</option>
                <option value="expert_advisors">🔬 3. Expert Advisors (Advisory Board & Subject Specialists)</option>
              </select>
            </div>

            <div class="col-md-6">
              <label class="form-label font-weight-bold">Qualifications / Degrees</label>
              <input type="text" name="qualification" class="form-control form-control-lg" placeholder="e.g. BPT, MPT (Cardio), PhD">
            </div>

            <div class="col-md-6">
              <label class="form-label font-weight-bold text-primary">
                <i class="ri-sort-asc me-1"></i> Position / Display Order
              </label>
              <input type="number" name="display_order" class="form-control form-control-lg fw-bold text-primary border-primary" value="<%= members.length + 1 %>" min="1" required>
            </div>

            <div class="col-12">
              <label class="form-label fw-bold">Profile Photo</label>

              <!-- Live preview -->
              <div class="d-flex align-items-center gap-3 mb-3">
                <img id="newPhotoPreview" src="/images/team/default-avatar.png"
                     alt="Preview" class="rounded-circle border shadow-sm"
                     style="width:80px;height:80px;object-fit:cover;"
                     onerror="this.src='/images/team/default-avatar.png'">
                <div>
                  <span class="fw-bold d-block text-dark">Photo Preview</span>
                  <span class="text-muted small" id="newPhotoLabel">No photo selected</span>
                </div>
              </div>

              <!-- Upload file -->
              <label class="form-label fw-semibold text-dark small">Upload Photo <span class="text-muted fw-normal">(JPG, PNG, WEBP — max 5 MB)</span></label>
              <input type="file" name="photo_file" id="newPhotoFileInput" accept="image/*" class="form-control mb-2"
                     onchange="previewNewTeamPhoto(this)">

              <!-- OR enter URL manually -->
              <label class="form-label fw-semibold text-dark small mt-1">Or enter photo URL manually</label>
              <input type="text" name="photo" class="form-control" placeholder="/images/team/default-avatar.png"
                     oninput="document.getElementById('newPhotoPreview').src=this.value||'/images/team/default-avatar.png';document.getElementById('newPhotoLabel').innerText=this.value||'No photo selected';">
              <small class="text-muted">If you upload a file above, the URL field is ignored. Leave both empty to use the default avatar.</small>
            </div>

            <script>
              function previewNewTeamPhoto(input) {
                if (input.files && input.files[0]) {
                  const reader = new FileReader();
                  reader.onload = e => {
                    document.getElementById('newPhotoPreview').src = e.target.result;
                    document.getElementById('newPhotoLabel').innerText = input.files[0].name;
                  };
                  reader.readAsDataURL(input.files[0]);
                }
              }
            </script>

            <div class="col-12">
              <label class="form-label font-weight-bold">Bio / Responsibilities Overview</label>
              <textarea name="bio" rows="3" class="form-control" placeholder="Brief summary of member experience and teaching subjects..."></textarea>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Right Column: Showcase & Submission -->
    <div class="col-lg-5">
      <div class="card shadow-sm border-0 mb-4" style="border-radius: 16px;">
        <div class="card-header bg-white py-3 border-bottom">
          <h5 class="mb-0 fw-bold text-dark"><i class="ri-star-line me-2 text-warning"></i>About Page Display</h5>
        </div>
        <div class="card-body p-4">
          <div class="form-check form-switch p-3 bg-light rounded-3 border mb-4">
            <input class="form-check-input ms-0 me-3" type="checkbox" name="show_on_about" value="1" id="showAboutPageSwitch">
            <label class="form-check-label font-weight-bold fs-6 text-dark" for="showAboutPageSwitch">
              <i class="ri-star-fill text-warning me-1"></i> Display Statement on About Page
            </label>
            <span class="text-muted small d-block mt-1">Enabling this makes this member's quote visible on `/about`.</span>
          </div>

          <div class="mb-4">
            <label class="form-label font-weight-bold text-dark fs-6">About Page Quote Statement (Optional)</label>
            <textarea name="statement" rows="5" class="form-control fs-6 p-3" placeholder="Enter quote or vision statement to showcase on About page..."></textarea>
          </div>

          <div class="d-grid gap-2">
            <button type="submit" class="btn btn-primary btn-lg rounded-pill fw-bold shadow">
              <i class="ri-check-line me-1"></i> Save & Add Team Member
            </button>
            <a href="/admin/team" class="btn btn-outline-secondary rounded-pill py-2">
              Cancel
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</form>
