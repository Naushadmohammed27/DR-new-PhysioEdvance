<div class="pe-page-header mb-4">
  <div class="d-flex flex-column flex-md-row align-items-start align-items-md-center justify-content-between gap-3">
    <div>
      <div class="d-flex align-items-center gap-2 mb-1">
        <span class="badge bg-danger-subtle text-danger px-2.5 py-1 rounded-pill fw-semibold" style="font-size: 0.75rem;">
          <i class="ri-shield-keyhole-line me-1"></i>Super Admin Exclusive
        </span>
      </div>
      <h1 class="h3 fw-bold text-slate-900 mb-1">Admin Management</h1>
      <p class="text-muted small mb-0">Create administrative users, delegate granular permissions, and monitor administrator accounts.</p>
    </div>
    <div class="d-flex gap-2">
      <a href="/admin/audit-logs" class="btn btn-outline-secondary rounded-pill px-3 py-2 text-sm fw-medium">
        <i class="ri-shield-check-line me-1.5"></i>Audit Logs
      </a>
      <a href="/admin/admins/new" class="btn btn-primary rounded-pill px-3.5 py-2 text-sm fw-semibold shadow-sm">
        <i class="ri-user-add-line me-1.5"></i>Create New Admin
      </a>
    </div>
  </div>
</div>

<div class="row g-3 mb-4">
  <div class="col-sm-6 col-xl-3">
    <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
      <div class="d-flex align-items-center justify-content-between">
        <div>
          <div class="text-muted small fw-medium">Total Administrators</div>
          <div class="h3 fw-bold text-slate-900 mt-1 mb-0"><%= admins.length %></div>
        </div>
        <div class="w-12 h-12 rounded-3 bg-primary-subtle text-primary d-flex align-items-center justify-content-center" style="width: 48px; height: 48px; font-size: 1.35rem;">
          <i class="ri-admin-line"></i>
        </div>
      </div>
    </div>
  </div>
  <div class="col-sm-6 col-xl-3">
    <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
      <div class="d-flex align-items-center justify-content-between">
        <div>
          <div class="text-muted small fw-medium">Active Accounts</div>
          <div class="h3 fw-bold text-success mt-1 mb-0"><%= admins.filter(a => a.is_active !== 0 && a.is_active !== false).length %></div>
        </div>
        <div class="w-12 h-12 rounded-3 bg-success-subtle text-success d-flex align-items-center justify-content-center" style="width: 48px; height: 48px; font-size: 1.35rem;">
          <i class="ri-checkbox-circle-line"></i>
        </div>
      </div>
    </div>
  </div>
  <div class="col-sm-6 col-xl-3">
    <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
      <div class="d-flex align-items-center justify-content-between">
        <div>
          <div class="text-muted small fw-medium">Disabled Accounts</div>
          <div class="h3 fw-bold text-danger mt-1 mb-0"><%= admins.filter(a => a.is_active === 0 || a.is_active === false).length %></div>
        </div>
        <div class="w-12 h-12 rounded-3 bg-danger-subtle text-danger d-flex align-items-center justify-content-center" style="width: 48px; height: 48px; font-size: 1.35rem;">
          <i class="ri-forbid-2-line"></i>
        </div>
      </div>
    </div>
  </div>
  <div class="col-sm-6 col-xl-3">
    <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
      <div class="d-flex align-items-center justify-content-between">
        <div>
          <div class="text-muted small fw-medium">Super Administrators</div>
          <div class="h3 fw-bold text-warning-emphasis mt-1 mb-0"><%= admins.filter(a => a.role === 'superadmin').length %></div>
        </div>
        <div class="w-12 h-12 rounded-3 bg-warning-subtle text-warning-emphasis d-flex align-items-center justify-content-center" style="width: 48px; height: 48px; font-size: 1.35rem;">
          <i class="ri-vip-crown-line"></i>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white mb-4">
  <div class="card-header bg-transparent border-0 px-4 pt-4 pb-3">
    <h5 class="fw-bold text-slate-900 mb-0">Administrator Directory</h5>
  </div>
  <div class="table-responsive">
    <table class="table align-middle mb-0">
      <thead class="bg-light text-muted small text-uppercase">
        <tr>
          <th class="ps-4 py-3">Administrator</th>
          <th class="py-3">Role</th>
          <th class="py-3">Permissions Status</th>
          <th class="py-3">Status</th>
          <th class="py-3">Created</th>
          <th class="text-end pe-4 py-3">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (!admins || admins.length === 0) { %>
          <tr>
            <td colspan="6" class="text-center py-5 text-muted">
              <i class="ri-user-search-line fs-2 mb-2 d-block text-slate-300"></i>
              No administrators found.
            </td>
          </tr>
        <% } else { %>
          <% admins.forEach(admin => { %>
            <tr class="hover-bg-light" style="cursor: pointer;" onclick="if (!event.target.closest('a, button, form, input')) window.location.href='/admin/admins/<%= admin.id %>';">
              <td class="ps-4 py-3">
                <a href="/admin/admins/<%= admin.id %>" class="d-flex align-items-center gap-3 text-decoration-none">
                  <div class="avatar rounded-circle bg-light border text-primary fw-bold d-flex align-items-center justify-content-center shadow-sm" style="width: 42px; height: 42px; flex-shrink: 0;">
                    <% if (admin.avatar) { %>
                      <img src="<%= admin.avatar %>" alt="<%= admin.name %>" class="rounded-circle w-100 h-100 object-fit-cover">
                    <% } else { %>
                      <%= admin.name.charAt(0).toUpperCase() %>
                    <% } %>
                  </div>
                  <div>
                    <div class="fw-bold text-slate-900 fs-6 hover-primary-text mb-0.5"><%= admin.name %> <i class="ri-external-link-line text-muted small ms-1" style="font-size: 0.8rem;"></i></div>
                    <div class="small text-muted"><%= admin.email %></div>
                    <span class="badge bg-light text-secondary border mt-1" style="font-size: 0.7rem;"><%= admin.user_code %></span>
                  </div>
                </a>
              </td>
              <td>
                <% if (admin.role === 'superadmin') { %>
                  <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2.5 py-1 rounded-pill">
                    <i class="ri-vip-crown-fill me-1"></i>Super Admin
                  </span>
                <% } else { %>
                  <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2.5 py-1 rounded-pill">
                    <i class="ri-admin-line me-1"></i>Admin
                  </span>
                <% } %>
              </td>
              <td>
                <% if (admin.role === 'superadmin') { %>
                  <span class="text-success small fw-semibold">
                    <i class="ri-checkbox-circle-fill me-1"></i>Full Master Access (All Resources)
                  </span>
                <% } else { %>
                  <div class="d-flex align-items-center gap-2" onclick="event.stopPropagation();">
                    <span class="badge bg-secondary-subtle text-secondary px-2 py-0.5 rounded-pill fw-medium">
                      <%= admin.permissionsCount || 0 %> Permissions Granted
                    </span>
                    <button type="button" class="btn btn-sm btn-link text-primary p-0 small fw-semibold text-decoration-none" data-bs-toggle="modal" data-bs-target="#permModal_<%= admin.id %>">
                      Configure <i class="ri-eye-line ms-0.5"></i>
                    </button>
                  </div>
                <% } %>
              </td>
              <td>
                <% if (admin.is_active === 0 || admin.is_active === false) { %>
                  <span class="badge bg-danger-subtle text-danger px-2.5 py-1 rounded-pill">
                    <i class="ri-close-circle-line me-1"></i>Disabled
                  </span>
                <% } else { %>
                  <span class="badge bg-success-subtle text-success px-2.5 py-1 rounded-pill">
                    <i class="ri-check-line me-1"></i>Active
                  </span>
                <% } %>
              </td>
              <td class="text-muted small">
                <%= new Date(admin.created_at).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) %>
              </td>
              <td class="text-end pe-4">
                <div class="d-flex align-items-center justify-content-end gap-1.5" onclick="event.stopPropagation();">
                  <a href="/admin/admins/<%= admin.id %>" class="btn btn-sm btn-outline-secondary rounded-pill px-2.5 py-1 text-xs fw-medium" title="View Full Details">
                    <i class="ri-user-line me-1"></i>View Details
                  </a>
                  <% if (admin.role !== 'superadmin') { %>
                    <a href="/admin/admins/<%= admin.id %>/permissions" class="btn btn-sm btn-outline-primary rounded-pill px-2.5 py-1 text-xs fw-medium" title="Configure Permissions">
                      <i class="ri-key-2-line me-1"></i>Permissions
                    </a>
                    <form action="/admin/admins/<%= admin.id %>/toggle-status" method="POST" class="d-inline" onsubmit="return confirm('Are you sure you want to <%= admin.is_active === 0 || admin.is_active === false ? 'activate' : 'disable' %> this admin account?');">
                      <button type="submit" class="btn btn-sm <%= admin.is_active === 0 || admin.is_active === false ? 'btn-outline-success' : 'btn-outline-danger' %> rounded-pill px-2.5 py-1 text-xs fw-medium">
                        <i class="<%= admin.is_active === 0 || admin.is_active === false ? 'ri-play-line' : 'ri-pause-line' %> me-1"></i>
                        <%= admin.is_active === 0 || admin.is_active === false ? 'Enable' : 'Disable' %>
                      </button>
                    </form>
                  <% } else { %>
                    <span class="badge bg-light text-muted border px-2.5 py-1 rounded-pill text-xs">Master Authority</span>
                  <% } %>
                </div>
              </td>
            </tr>

            <!-- Modal: Permission Preview for Admin #<%= admin.id %> -->
            <div class="modal fade" id="permModal_<%= admin.id %>" tabindex="-1" aria-labelledby="permModalLabel_<%= admin.id %>" aria-hidden="true" onclick="event.stopPropagation();">
              <div class="modal-dialog modal-dialog-centered modal-lg">
                <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden text-start">
                  <div class="modal-header bg-light py-3 px-4 border-bottom">
                    <div class="d-flex align-items-center gap-3">
                      <div class="avatar rounded-circle bg-primary-subtle text-primary fw-bold d-flex align-items-center justify-content-center border shadow-sm" style="width: 44px; height: 44px; flex-shrink: 0;">
                        <% if (admin.avatar) { %>
                          <img src="<%= admin.avatar %>" alt="<%= admin.name %>" class="rounded-circle w-100 h-100 object-fit-cover">
                        <% } else { %>
                          <%= admin.name.charAt(0).toUpperCase() %>
                        <% } %>
                      </div>
                      <div>
                        <h5 class="modal-title fw-bold text-dark mb-0" id="permModalLabel_<%= admin.id %>"><%= admin.name %></h5>
                        <span class="text-muted small"><%= admin.email %> &bull; <code class="text-primary"><%= admin.user_code %></code></span>
                      </div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                  </div>

                  <div class="modal-body p-4">
                    <% if (admin.role === 'superadmin') { %>
                      <div class="p-4 rounded-3 bg-warning-subtle text-warning-emphasis border border-warning-subtle text-center">
                        <i class="ri-vip-crown-fill fs-2 mb-2 d-block"></i>
                        <h6 class="fw-bold mb-1">Super Administrator Account</h6>
                        <p class="small mb-0">This user holds Master Authority and has unrestricted access to all platform resources, settings, and administrator management tools.</p>
                      </div>
                    <% } else { %>
                      <div class="d-flex align-items-center justify-content-between mb-3">
                        <h6 class="fw-bold text-dark mb-0"><i class="ri-shield-keyhole-line text-primary me-2"></i>Assigned Permissions Breakdown</h6>
                        <span class="badge bg-primary text-white rounded-pill px-3 py-1 font-weight-bold">
                          <%= admin.permissionsCount || 0 %> Active Permissions
                        </span>
                      </div>

                      <% if (!admin.permissions || admin.permissions.length === 0) { %>
                        <div class="p-4 rounded-3 bg-light border text-center text-muted">
                          <i class="ri-shield-line fs-2 mb-2 d-block text-slate-400"></i>
                          <p class="fw-semibold text-dark mb-1">No Explicit Permissions Assigned</p>
                          <span class="small d-block text-secondary">This administrator account currently has 0 active permission grants. Click "Configure Full Permissions" below to grant access.</span>
                        </div>
                      <% } else { %>
                        <% 
                          const permGroups = {};
                          admin.permissions.forEach(pk => {
                            const parts = pk.split(':');
                            const resKey = parts[0] || 'GENERAL';
                            const actKey = parts[1] || 'VIEW';
                            if (!permGroups[resKey]) permGroups[resKey] = [];
                            permGroups[resKey].push(actKey);
                          });
                          
                          const resourceMeta = {
                            'SUBJECT': { label: 'Subjects & Curriculum Categories', icon: 'ri-folder-2-line', color: 'primary' },
                            'CASE_DISCUSSION': { label: 'Live Discussions & Q&A Desk', icon: 'ri-question-answer-line', color: 'cyan' },
                            'COURSE': { label: 'Courses & Learning Modules', icon: 'ri-book-read-line', color: 'emerald' },
                            'LIVE_CLASS': { label: 'Live Classes & Webinars', icon: 'ri-vidicon-line', color: 'red' },
                            'BLOG': { label: 'Blog & Articles', icon: 'ri-article-line', color: 'purple' },
                            'USER': { label: 'User Management', icon: 'ri-team-line', color: 'orange' },
                            'AUDIT_LOG': { label: 'Audit Trail Logs', icon: 'ri-shield-check-line', color: 'sky' },
                            'SETTINGS': { label: 'Platform & Homepage Settings', icon: 'ri-settings-4-line', color: 'amber' }
                          };
                        %>
                        <div class="row g-3">
                          <% Object.keys(permGroups).forEach(resKey => { 
                            const meta = resourceMeta[resKey] || { label: resKey.replace(/_/g, ' '), icon: 'ri-lock-line', color: 'primary' };
                            const acts = permGroups[resKey];
                          %>
                            <div class="col-md-6">
                              <div class="p-3 border rounded-3 bg-white h-100 shadow-sm d-flex flex-column justify-content-between">
                                <div class="d-flex align-items-center gap-2 mb-2">
                                  <div class="rounded-2 p-1.5 bg-<%= meta.color %>-subtle text-<%= meta.color %> d-flex align-items-center justify-content-center" style="width: 30px; height: 30px; font-size: 1rem;">
                                    <i class="<%= meta.icon %>"></i>
                                  </div>
                                  <span class="fw-bold text-dark small"><%= meta.label %></span>
                                </div>
                                <div class="d-flex flex-wrap gap-1.5 mt-1">
                                  <% acts.forEach(act => { %>
                                    <span class="badge bg-light text-primary border font-weight-bold px-2 py-0.5 text-uppercase" style="font-size: 0.68rem;">
                                      <i class="ri-check-line text-success me-0.5"></i><%= act %>
                                    </span>
                                  <% }) %>
                                </div>
                              </div>
                            </div>
                          <% }) %>
                        </div>
                      <% } %>
                    <% } %>
                  </div>

                  <div class="modal-footer bg-light py-2.5 px-4 border-top d-flex align-items-center justify-content-between">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-4 btn-sm" data-bs-dismiss="modal">Close</button>
                    <% if (admin.role !== 'superadmin') { %>
                      <a href="/admin/admins/<%= admin.id %>/permissions" class="btn btn-primary rounded-pill px-4 btn-sm font-weight-bold shadow-sm">
                        <i class="ri-edit-box-line me-1"></i> Configure Full Permissions
                      </a>
                    <% } %>
                  </div>
                </div>
              </div>
            </div>
          <% }) %>
        <% } %>
      </tbody>
    </table>
  </div>
</div>
